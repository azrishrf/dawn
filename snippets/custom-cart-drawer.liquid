<style>
  .cart-drawer-overlay,
  .variant-drawer-overlay {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
</style>
<div class="cart-drawer-overlay" id="cartDrawer">
  <div class="cart-drawer-backdrop" onclick="closeCartDrawer()"></div>
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-title">SHOPPING CART</h2>
      <button onclick="closeCartDrawer()" class="cart-drawer-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="cart-drawer-body">
      <div class="cart-drawer-reservation-notice" style="display: none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <p>
          <strong>Unlock exclusive add-on discounts</strong> <br>
          Available with any Protein Set purchase.
        </p>
      </div>

      <div class="cart-drawer-items-container">
        <div class="cart-items-loading-overlay" id="cartItemsLoadingOverlay">
          <div class="cart-drawer-spinner"></div>
        </div>
        <div class="cart-drawer-items" id="cartDrawerItems">
          <!-- Cart items will be dynamically inserted here -->
        </div>
      </div>
      <div class="cart-drawer-extras" id="cartDrawerExtras">
        <div class="extras-header">
          <h3 class="extras-title">COMPLETE YOUR STACK</h3>
          <p class="extras-subtitle">Add this bundle now and enjoy special add-on pricing</p>
        </div>

        {% assign extras_layout = settings.cart_extras_layout | default: 'grid' %}

        <div class="extras-container layout-{{ extras_layout }}">
          {% for i in (1..5) %}
            {% assign extra_setting = 'cart_extra_product_' | append: i %}
            {% assign use_variant = 'cart_extra_use_variant_' | append: i %}
            {% assign allowed_variants_setting = 'cart_extra_allowed_variants_' | append: i %}
            {% assign extra_product = all_products[settings[extra_setting]] %}

            {% if extra_product != blank %}
              <div
                class="extra-item"
                data-extra-item-handle="{{ extra_product.handle }}"
                data-base-price="{{ extra_product.price }}"
                data-variant-title="{{ extra_product.selected_or_first_available_variant.title }}"
              >
                <div class="extra-item-image-wrap">
                  <img
                    src="{{ extra_product.featured_image | image_url: width: 100 }}"
                    width="100"
                    height="{{ 100 | divided_by: extra_product.featured_image.aspect_ratio | ceil }}"
                    alt="{{ extra_product.title }}"
                    class="extra-item-image"
                  >
                </div>
                <div class="extra-item-details">
                  {% comment %} <div class="extra-item-badge">NEW & IMPROVED</div> {% endcomment %}
                  <div class="extra-item-title">{{ extra_product.title }}</div>
                  <div class="extra-item-price-action">
                    <div class="extra-item-price-wrapper">
                      {% if extra_product.compare_at_price > extra_product.price %}
                        <span class="extra-item-old-price">{{ extra_product.compare_at_price | money }}</span>
                      {% endif %}
                      <span class="extra-item-price">{{ extra_product.price | money }}</span>
                    </div>
                    {% if settings[use_variant] %}
                      <button
                        class="extra-item-add-btn"
                        onclick="openExtraVariantDrawer('{{ extra_product.handle }}', this)"
                        data-product-title="{{ extra_product.title | escape }}"
                        data-product-image="{{ extra_product.featured_image | image_url: width: 200 }}"
                        data-product-price="{{ extra_product.price | money_without_currency }}"
                        data-product-compare-at-price="{{ extra_product.compare_at_price | money_without_currency }}"
                        data-product-options="{{ extra_product.options.first | escape }}"
                        data-variants="{{ extra_product.variants | json | escape }}"
                        data-allowed-variants="{{ settings[allowed_variants_setting] | escape }}"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="8" x2="12" y2="16"></line>
                          <line x1="8" y1="12" x2="16" y2="12"></line>
                        </svg>
                        ADD
                      </button>
                    {% else %}
                      <button
                        class="extra-item-add-btn"
                        onclick="addExtraToCart({{ extra_product.selected_or_first_available_variant.id }}, this)"
                      >
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="8" x2="12" y2="16"></line>
                          <line x1="8" y1="12" x2="16" y2="12"></line>
                        </svg>
                        ADD
                      </button>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="cart-drawer-footer">
      <div id="cartDrawerFooterTotals">
        <div class="cart-drawer-total">
          <span>SUBTOTAL</span>
          <span id="cartDrawerTotal">RM 0.00</span>
        </div>
      </div>
      <a href="/checkout" class="cart-drawer-button cart-drawer-checkout">
        <svg fill="#ffffff" width="16" height="16" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 9V7c0-3.308 2.692-6 6-6s6 2.692 6 6v2h5v18H5V9h5zM12 9h8V7c0-2.206-1.794-4-4-4s-4 1.794-4 4v2z" fill="#ffffff" />
        </svg>
        CHECKOUT SECURELY
      </a>
    </div>
  </div>
</div>

<!-- Variant Drawer Overlay -->
<div class="variant-drawer-overlay" id="variantDrawer">
  <div class="variant-drawer-backdrop" onclick="closeVariantDrawer()"></div>
  <div class="variant-drawer">
    <div class="variant-drawer-header">
      <h2 class="variant-drawer-title" id="variantDrawerTitle">ADD TO CART</h2>
      <button onclick="closeVariantDrawer()" class="variant-drawer-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="variant-drawer-body" id="variantDrawerBody">
      <div class="variant-drawer-loading">Loading options...</div>
    </div>
  </div>
</div>

<style>
  /* Cart Drawer Styles */
  .cart-drawer-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    z-index: 9999999 !important; /* Maximum priority */
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    background-color: rgba(0, 0, 0, 0.6) !important;
    backdrop-filter: blur(4px) !important;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .cart-drawer-overlay.active {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer-backdrop {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    cursor: pointer;
  }

  .cart-drawer {
    position: fixed; /* Changed to fixed so it's immune to relative parent constraints */
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-height: 90vh;
    max-height: 90dvh;
    background-color: #fff;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    z-index: 99999;
  }

  .cart-drawer-overlay.active .cart-drawer {
    transform: translateY(0);
  }

  @media (min-width: 1024px) {
    .cart-drawer {
      left: auto;
      right: 0;
      top: 0;
      bottom: 0;
      width: 600px;
      max-width: 90vw;
      max-height: none;
      transform: translateX(100%);
      border-radius: 0;
      box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
    }

    .cart-drawer-overlay.active .cart-drawer {
      transform: translateX(0);
    }
  }

  .cart-drawer-header {
    padding: 16px 20px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: center; /* Center title */
    align-items: center;
    background: #fff;
    position: relative; /* For absolute positioning of close button */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }

  @media (min-width: 1024px) {
    .cart-drawer-header {
      border-radius: 0;
    }
  }

  .cart-drawer-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
    text-align: center;
  }

  .cart-drawer-reservation-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: #f7f7f7;
    margin: 16px 20px 0;
    padding: 12px 16px;
    border-radius: 4px;
  }

  .cart-drawer-reservation-notice p {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: #333;
  }

  .cart-drawer-reservation-notice svg {
    flex-shrink: 0;
    color: #666;
  }

  .cart-drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    transition: opacity 0.2s ease;
    color: #111;
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer-close:hover {
    opacity: 0.7;
  }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer-items-container {
    position: relative;
  }

  .cart-items-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.7);
    z-index: 10;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .cart-items-loading-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid #eee;
    border-top: 3px solid #111;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .cart-drawer-spinner--small {
    width: 16px !important;
    height: 16px !important;
    border: 2px solid #eee !important;
    border-top: 2px solid #111 !important;
    border-radius: 50% !important;
    display: inline-block !important;
    animation: spin 0.8s linear infinite !important;
    box-sizing: border-box !important;
    vertical-align: middle;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

