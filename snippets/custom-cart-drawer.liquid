{% comment %}
  Renders a custom cart drawer
  This snippet should be rendered in theme.liquid
{% endcomment %}

<custom-cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CustomCartDrawer" class="custom-cart-drawer">
    <div id="CustomCartDrawer-Overlay" class="custom-cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="custom-cart-drawer__header">
            <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
            <button
              class="drawer__close"
              type="button"
              onclick="this.closest('custom-cart-drawer').close()"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>
          <div class="cart-drawer__empty-content">
            <h2>{{ 'sections.cart.empty' | t }}</h2>
            <a href="{{ routes.all_products_collection_url }}" class="button">
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>
        </div>
      {%- else -%}
        <div class="drawer__header">
          <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
          <button
            class="drawer__close"
            type="button"
            onclick="this.closest('custom-cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
        </div>
        <div class="custom-cart-drawer__contents">
          <div class="drawer__cart-items-wrapper">
            <div class="custom-cart-drawer__items" role="list">
              {%- for item in cart.items -%}
                <div class="custom-cart-drawer__item" role="listitem">
                  <div class="cart-item__media">
                    {% if item.image %}
                      <img
                        class="cart-item__image"
                        src="{{ item.image | image_url: width: 150 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="150"
                        height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                      >
                    {% endif %}
                  </div>
                  <div class="cart-item__details">
                    <a href="{{ item.url }}" class="cart-item__name h4">
                      {{ item.product.title | escape }}
                    </a>
                    {%- if item.product.has_only_default_variant == false
                      or item.properties.size != 0
                      or item.selling_plan_allocation != null
                    -%}
                      <dl class="cart-item__options">
                        {%- if item.product.has_only_default_variant == false -%}
                          {%- for option in item.options_with_values -%}
                            <div class="product-option">
                              <dt>{{ option.name }}:</dt>
                              <dd>{{ option.value }}</dd>
                            </div>
                          {%- endfor -%}
                        {%- endif -%}
                      </dl>
                    {%- endif -%}
                    <div class="cart-item__price-wrapper">
                      <span class="price">
                        {{ item.final_line_price | money }}
                      </span>
                      {%- if item.original_line_price != item.final_line_price -%}
                        <span class="cart-item__old-price price price--end">
                          {{ item.original_line_price | money }}
                        </span>
                      {%- endif -%}
                    </div>
                    <div class="cart-item__quantity">
                      <span class="quantity__label">{{ 'products.product.quantity.label' | t }}</span>
                      <span class="quantity__value">{{ item.quantity }}</span>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="custom-cart-drawer__footer">
            <div class="totals">
              <h3 class="totals__subtotal">{{ 'sections.cart.estimated_total' | t }}</h3>
              <p class="totals__subtotal-value">{{ cart.total_price | money_with_currency }}</p>
            </div>
            <div class="cart__ctas">
              <a href="{{ routes.cart_url }}" class="button button--secondary">
                {{ 'general.cart.view_empty_cart' | t }}
              </a>
              <button type="submit" class="button" name="checkout" form="cart">
                {{ 'sections.cart.checkout' | t }}
              </button>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</custom-cart-drawer>

<style>
  .custom-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 999;
    visibility: hidden;
    pointer-events: none;
  }

  custom-cart-drawer.active .custom-cart-drawer {
    visibility: visible;
    pointer-events: all;
  }

  .custom-cart-drawer__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0);
    transition: background-color 0.3s ease;
  }

  custom-cart-drawer.active .custom-cart-drawer__overlay {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .custom-cart-drawer .drawer__inner {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 450px;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    background-color: rgb(var(--color-background));
    display: flex;
    flex-direction: column;
  }

  custom-cart-drawer.animate .custom-cart-drawer .drawer__inner {
    transform: translateX(0);
  }

  .custom-cart-drawer__header,
  .drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .drawer__heading {
    margin: 0;
    font-size: 2rem;
  }

  .drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drawer__close svg {
    width: 2rem;
    height: 2rem;
  }

  .custom-cart-drawer__contents {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .drawer__cart-items-wrapper {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
  }

  .custom-cart-drawer__item {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .custom-cart-drawer__item:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-item__media {
    flex-shrink: 0;
    width: 100px;
  }

  .cart-item__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
  }

  .cart-item__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-item__name {
    margin: 0;
    font-size: 1.4rem;
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .cart-item__name:hover {
    text-decoration: underline;
  }

  .cart-item__options {
    margin: 0;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .product-option {
    display: flex;
    gap: 0.5rem;
  }

  .product-option dt {
    font-weight: 600;
  }

  .product-option dd {
    margin: 0;
  }

  .cart-item__price-wrapper {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .cart-item__old-price {
    text-decoration: line-through;
    color: rgba(var(--color-foreground), 0.5);
  }

  .cart-item__quantity {
    display: flex;
    gap: 0.5rem;
    font-size: 1.2rem;
  }

  .quantity__label {
    font-weight: 600;
  }

  .custom-cart-drawer__footer {
    padding: 2rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    background-color: rgb(var(--color-background));
  }

  .totals {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .totals__subtotal {
    margin: 0;
    font-size: 1.6rem;
  }

  .totals__subtotal-value {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 700;
  }

  .cart__ctas {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .drawer__inner-empty {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cart-drawer__empty-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    gap: 2rem;
  }

  body.overflow-hidden {
    overflow: hidden;
  }
</style>
