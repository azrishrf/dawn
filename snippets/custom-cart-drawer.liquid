    transition: opacity 0.2s ease;
    color: #111;
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .variant-drawer-close:hover {
    opacity: 0.7;
  }

  .variant-drawer-body {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .variant-drawer-product-info {
    display: flex;
    gap: 16px;
    padding: 20px;
  }

  .variant-drawer-product-image {
    width: 90px;
    height: 110px;
    object-fit: cover;
    background: #f4f4f4;
  }

  .variant-drawer-product-details {
    display: flex;
    flex-direction: column;
  }

  .vd-product-title {
    font-size: 13px;
    color: #444;
    line-height: 1.4;
  }

  .vd-product-options {
    font-size: 11px;
    color: #888;
    margin-top: 4px;
    margin-bottom: 8px;
  }

  .vd-product-price {
    font-size: 16px;
    font-weight: 700;
    color: #111;
  }

  .variant-drawer-select-header {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0 20px 12px 20px;
    text-transform: uppercase;
  }

  .variant-option-list {
    border-top: 1px solid #eee;
    margin-bottom: 30px;
  }

  .variant-option-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    border-bottom: 1px solid #eee;
    cursor: pointer;
    background: #fff;
    transition: background-color 0.2s;
  }

  .variant-option-item:hover {
    background-color: #f9f9f9;
  }

  .variant-option-item.sold-out {
    cursor: not-allowed;
    background-color: #fff;
  }

  .variant-option-title {
    font-size: 13px;
    font-weight: 700;
    color: #111;
  }

  .variant-option-item.sold-out .variant-option-title {
    color: #999;
    text-decoration: line-through;
  }

  .variant-option-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .variant-option-price {
    font-size: 13px;
    font-weight: 400;
    color: #666;
  }

  .variant-option-action {
    font-size: 13px;
    font-weight: 700;
    color: #111;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .variant-option-item.sold-out .variant-option-action {
    color: #999;
  }

  .variant-drawer-loading {
    text-align: center;
    padding: 40px;
    color: #666;
  }
</style>

<script>
  const EXTRA_ADD_BUTTON_DEFAULT_HTML = `
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="16"></line>
      <line x1="8" y1="12" x2="16" y2="12"></line>
    </svg>
    ADD
  `;

  function normalizeExtraAddButtonLabel(btn) {
    if (!btn) return;
    if (btn.querySelector('.cart-drawer-spinner--small')) return;

    const rawText = (btn.textContent || '').trim().toUpperCase();
    const hasAddLabel = rawText === 'ADD';
    const hasIcon = !!btn.querySelector('svg');

    if (!hasAddLabel || !hasIcon) {
      btn.innerHTML = EXTRA_ADD_BUTTON_DEFAULT_HTML;
    }
  }

  function normalizeAllExtraAddButtons() {
    document.querySelectorAll('.extra-item-add-btn').forEach(normalizeExtraAddButtonLabel);
  }

  // Cart Drawer Functions
  window.openCartDrawer = function () {
    document.getElementById('cartDrawer').classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  window.closeCartDrawer = function () {
    document.getElementById('cartDrawer').classList.remove('active');
    document.body.style.overflow = '';
  };

  // Buy X Get Y Rules Configuration
  function getEffectivePrice(variantId, productHandle, basePrice, cart, variantTitle = null) {
    let effectivePrice = basePrice;
    let discountLabel = null;

    const items = cart.items || [];
    const lowerHandle = productHandle.toLowerCase();
    const lowerVariantTitle = (variantTitle || '').toLowerCase();

    // 1. Count Total Protein Triggers available in cart
    const proteinCount = items.reduce((total, item) => {
      if (item.handle.toLowerCase().includes('protein')) return total + item.quantity;
      return total;
    }, 0);

    // 2. Count how many items are already 'consuming' these triggers
    // We count all items that qualify for ANY of our three rules
    const totalConsumed = items.reduce((total, item) => {
      const h = item.handle.toLowerCase();
      const t = (item.title || '').toLowerCase();

      const isS = h.includes('seasoning');
      const isSh = h.includes('shaker') && h.includes('600ml');
      const isC = h.includes('creatine') && t.includes('500g');
      const isA = h.includes('apparel');

      if (isS || isSh || isC || isA) return total + item.quantity;
      return total;
    }, 0);

    // 3. Determine if the current item (the one we are checking) is already in the cart.
    // If it is, we need to know if it's currently 'covered' by a trigger.
    // However, for the 'Extra' drawer simulation, we usually check the "next" item to be added.
    // So we use: proteinCount > totalConsumed

    if (proteinCount > totalConsumed) {
      // Check Rule 3 (Best Discount: RM 10.00)
      const isCreatineTarget = lowerHandle.includes('creatine') && lowerVariantTitle.includes('500g');
      const isApparelTarget = lowerHandle.includes('apparel');
      if (isCreatineTarget || isApparelTarget) {
        const newPrice = Math.max(0, basePrice - 1000);
        if (newPrice < effectivePrice) {
          effectivePrice = newPrice;
          discountLabel = 'RM 10.00 OFF with Protein';
        }
      }

      // Check Rule 2 (Second Best: RM 2.10)
      const isShaker600 = lowerHandle.includes('shaker') && lowerHandle.includes('600ml');
      if (isShaker600) {
        const newPrice = Math.max(0, basePrice - 210);
        if (newPrice < effectivePrice) {
          effectivePrice = newPrice;
          discountLabel = 'RM 2.10 OFF with Protein';
        }
      }

      // Check Rule 1 (Third Best: RM 2.00)
      const isSeasoning = lowerHandle.includes('seasoning');
      if (isSeasoning) {
        const newPrice = Math.max(0, basePrice - 200);
        if (newPrice < effectivePrice) {
          effectivePrice = newPrice;
          discountLabel = 'RM 2.00 OFF with Protein';
        }
      }
    }

    return { price: effectivePrice, discountLabel: discountLabel };
  }

  window.updateCartDrawer = async function () {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();

      const itemsContainer = document.getElementById('cartDrawerItems');
      const footerTotalsContainer = document.getElementById('cartDrawerFooterTotals');

      // Update Extras Prices based on BXGY
      const extraItems = document.querySelectorAll('.extra-item');
      extraItems.forEach((itemEl) => {
        const handle = itemEl.getAttribute('data-extra-item-handle');
        const variantTitle = itemEl.getAttribute('data-variant-title');
        const priceWrapper = itemEl.querySelector('.extra-item-price-wrapper');
        const currentPriceEl = itemEl.querySelector('.extra-item-price');
        const oldPriceEl = itemEl.querySelector('.extra-item-old-price');

        const basePrice = parseInt(itemEl.getAttribute('data-base-price') || '0');
        const { price, discountLabel } = getEffectivePrice(null, handle, basePrice, cart, variantTitle);

        if (price < basePrice) {
          if (!oldPriceEl) {
            const newOldPrice = document.createElement('span');
            newOldPrice.className = 'extra-item-old-price';
            newOldPrice.textContent = `RM ${(basePrice / 100).toFixed(2)}`;
            priceWrapper.insertBefore(newOldPrice, currentPriceEl);
          } else {
            oldPriceEl.textContent = `RM ${(basePrice / 100).toFixed(2)}`;
            oldPriceEl.style.display = 'inline';
          }
          currentPriceEl.textContent = price === 0 ? 'FREE' : `RM ${(price / 100).toFixed(2)}`;
          currentPriceEl.style.color = '#cf2317'; // Discount red
        } else {
          if (oldPriceEl) oldPriceEl.style.display = 'none';
          currentPriceEl.textContent = `RM ${(basePrice / 100).toFixed(2)}`;
          currentPriceEl.style.color = '';
        }
      });

      normalizeAllExtraAddButtons();

      if (cart.items.length === 0) {
        itemsContainer.innerHTML = '<div class="cart-drawer-empty">Your cart is empty</div>';
        footerTotalsContainer.innerHTML = `
          <div class="cart-drawer-total">
            <span>SUBTOTAL</span>
            <span id="cartDrawerTotal">RM 0.00</span>
          </div>
        `;
      } else {
        // Group items by SKU
        const groupedItemsMap = {};
        cart.items.forEach((item) => {
          const groupKey = item.sku && item.sku !== '' ? item.sku : `id-${item.variant_id}`;
          if (groupedItemsMap[groupKey]) {
            groupedItemsMap[groupKey].quantity += item.quantity;
            groupedItemsMap[groupKey].original_line_price += item.original_line_price;
            groupedItemsMap[groupKey].final_line_price += item.final_line_price;
            // Optionally merge discount allocations if needed, but skipped for simplicity as requested
          } else {
            groupedItemsMap[groupKey] = { ...item };
          }
        });

        const groupedItems = Object.entries(groupedItemsMap).map(([key, item]) => {
          return { ...item, groupKey: key };
        });

        itemsContainer.innerHTML = groupedItems
          .map((item) => {
            const hasDiscount = item.original_line_price !== item.final_line_price;
            const groupKey = item.groupKey;
            return `
          <div class="cart-drawer-item">
            <img src="${item.image}" alt="${item.title}" class="cart-item-image">
            <div class="cart-item-details">
              <div class="cart-item-info">
                <div class="cart-item-title">${item.product_title}</div>
                ${item.variant_title ? `<div class="cart-item-variant">${item.variant_title}</div>` : ''}
              </div>
              <div class="cart-item-actions">
                <div class="cart-item-price-wrapper">
                  ${
                    hasDiscount
                      ? `<span class="cart-item-old-price">RM ${(item.original_line_price / 100).toFixed(2)}</span>`
                      : ''
                  }
                  <div class="cart-item-price">RM ${(item.final_line_price / 100).toFixed(2)}</div>
                </div>
                <div class="cart-item-quantity-controls">
                  <button class="cart-item-remove-btn" onclick="updateGroupQty('${groupKey}', 0)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>
                  </button>
                  <button class="cart-item-quantity-btn" onclick="updateGroupQty('${groupKey}', -1)">
                    <svg width="12" height="2" viewBox="0 0 12 2" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="0" y1="1" x2="12" y2="1"></line></svg>
                  </button>
                  <span class="cart-item-qty-text">${item.quantity}</span>
                  <button class="cart-item-quantity-btn" onclick="updateGroupQty('${groupKey}', 1)">
                     <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="6" y1="0" x2="6" y2="12"></line><line x1="0" y1="6" x2="12" y2="6"></line></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
          })
          .join('');

        // Build footer totals
        let footerHtml = '';
        const totalDiscount = cart.total_discount || 0;

        if (totalDiscount > 0) {
          footerHtml += `
            <div class="cart-drawer-footer-row">
              <span>SUBTOTAL</span>
              <span>RM ${(cart.original_total_price / 100).toFixed(2)}</span>
            </div>
            <div class="cart-drawer-footer-row discount">
              <span>DISCOUNTS</span>
              <span>-RM ${(totalDiscount / 100).toFixed(2)}</span>
            </div>
          `;
        }

        footerHtml += `
          <div class="cart-drawer-total">
            <span>${totalDiscount > 0 ? 'TOTAL' : 'SUBTOTAL'}</span>
            <span id="cartDrawerTotal">RM ${(cart.total_price / 100).toFixed(2)}</span>
          </div>
        `;
        footerTotalsContainer.innerHTML = footerHtml;
      }

      const noticeElement = document.querySelector('.cart-drawer-reservation-notice');
      if (cart.items.length > 0) {
        if (noticeElement) noticeElement.style.display = 'flex';
      } else {
        if (noticeElement) noticeElement.style.display = 'none';
      }

      // Update header cart count
      const cartCountElement = document.getElementById('cartCount');
      if (cartCountElement) {
        cartCountElement.textContent = cart.item_count;
      }
    } catch (error) {
      console.error('Error updating cart drawer:', error);
    }
  };

  async function updateGroupQty(groupKey, delta) {
    const overlay = document.getElementById('cartItemsLoadingOverlay');
    const totalElement = document.getElementById('cartDrawerTotal');

    if (overlay) overlay.classList.add('active');
    if (totalElement) {
      totalElement.innerHTML = '<span class="cart-drawer-spinner cart-drawer-spinner--small"></span>';
    }

    try {
      const cartResponse = await fetch('/cart.js');
      const cart = await cartResponse.json();

      // Find all line items that belong to this group
      const matchingItems = cart.items.filter((item) => {
        const itemGroupKey = item.sku && item.sku !== '' ? item.sku : `id-${item.variant_id}`;
        return itemGroupKey === groupKey;
      });

      if (matchingItems.length === 0) return;

      if (delta === 0) {
        // Remove all items in group
        const updates = {};
        matchingItems.forEach((item) => {
          updates[item.key] = 0;
        });
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ updates }),
        });
      } else if (delta > 0) {
        // Add 1 of the first variant in the group
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [
              {
                id: matchingItems[0].variant_id,
                quantity: delta,
              },
            ],
          }),
        });
      } else if (delta < 0) {
        // Remove 1 unit from the last item in the group that has quantity
        const itemToReduce = matchingItems[matchingItems.length - 1];
        await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: itemToReduce.key,
            quantity: Math.max(0, itemToReduce.quantity + delta),
          }),
        });
      }

      await updateCartDrawer();
    } catch (error) {
      console.error('Error updating grouped quantity:', error);
    } finally {
      if (overlay) overlay.classList.remove('active');
    }
  }

  async function updateCartItemQty(key, quantity) {
    const overlay = document.getElementById('cartItemsLoadingOverlay');
    const totalElement = document.getElementById('cartDrawerTotal');

    if (overlay) overlay.classList.add('active');
    if (totalElement) {
      totalElement.innerHTML = '<span class="cart-drawer-spinner cart-drawer-spinner--small"></span>';
    }

    try {
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: key,
          quantity: quantity,
        }),
      });
      await updateCartDrawer();
    } catch (error) {
      console.error('Error updating cart quantity:', error);
    } finally {
      if (overlay) overlay.classList.remove('active');
    }
  }

  async function addExtraToCart(variantId, btnElement) {
    let originalHtml;
    if (btnElement) {
      originalHtml = btnElement.innerHTML;
      btnElement.innerHTML = '<span class="cart-drawer-spinner cart-drawer-spinner--small"></span>';
      btnElement.disabled = true;
    }

    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          items: [
            {
              id: variantId,
              quantity: 1,
            },
          ],
        }),
      });
      console.log('Extra item added from drawer');
      await updateCartDrawer();
    } catch (error) {
      console.error('Error adding extra to cart:', error);
    } finally {
      if (btnElement && originalHtml) {
        btnElement.innerHTML = originalHtml;
        btnElement.disabled = false;
        normalizeExtraAddButtonLabel(btnElement);
      }
    }
  }

  function openVariantDrawer() {
    document.getElementById('variantDrawer').classList.add('active');
  }

  function closeVariantDrawer() {
    document.getElementById('variantDrawer').classList.remove('active');
  }

  async function openExtraVariantDrawer(productHandle, btnElement) {
    console.log('Opening variant drawer for handle: ', productHandle);

    // Show spinner on the ADD button while fetching
    const originalHtml = btnElement.innerHTML;
    btnElement.innerHTML = '<span class="cart-drawer-spinner cart-drawer-spinner--small"></span>';
    btnElement.disabled = true;

    const body = document.getElementById('variantDrawerBody');
    const titleStr = btnElement.getAttribute('data-product-title');
    const imgStr = btnElement.getAttribute('data-product-image');

    try {
      // Get current cart state for real-time discount simulation
      const cartResponse = await fetch('/cart.js');
      const cart = await cartResponse.json();

      let priceStr = (
        parseInt(btnElement.closest('.extra-item')?.getAttribute('data-base-price') || '0') / 100
      ).toFixed(2);
      let compareAtPriceStr = btnElement.getAttribute('data-product-compare-at-price');
      const optionsRaw = btnElement.getAttribute('data-product-options');
      const variantsRaw = btnElement.getAttribute('data-variants');
      const allowedVariantsRaw = btnElement.getAttribute('data-allowed-variants');

      const normalizedProductHandle = productHandle;

      let optionName = 'OPTION';
      if (optionsRaw) {
        optionName = optionsRaw.toUpperCase();
      }

      let variants = [];
      try {
        variants = JSON.parse(variantsRaw);
      } catch (e) {
        console.error('Could not parse variants JSON');
      }

      if (allowedVariantsRaw && allowedVariantsRaw.trim() !== '') {
        const allowedArr = allowedVariantsRaw
          .split(',')
          .map((s) =>
            s
              .trim()
              .toLowerCase()
              .replace(/^['"]|['"]$/g, '')
          )
          .filter((s) => s !== '');

        if (allowedArr.length > 0) {
          const filtered = variants.filter((v) => {
            const titleParts = v.title
              .toLowerCase()
              .split('/')
              .map((p) => p.trim());
            return allowedArr.some(
              (allowed) => titleParts.includes(allowed) || v.title.toLowerCase().trim() === allowed
            );
          });
          if (filtered.length > 0) {
            variants = filtered;
          }
        }
      }

      if (variants.length > 0) {
        const { price, discountLabel } = getEffectivePrice(
          variants[0].id,
          normalizedProductHandle,
          variants[0].price,
          cart,
          variants[0].title
        );
        priceStr = (price / 100).toFixed(2);
        compareAtPriceStr =
          price < variants[0].price
            ? (variants[0].price / 100).toFixed(2)
            : variants[0].compare_at_price
            ? (variants[0].compare_at_price / 100).toFixed(2)
            : null;
      }

      let productInfoHtml = `
      <div class="variant-drawer-product-info">
         <img src="${imgStr}" alt="product image" class="variant-drawer-product-image" />
         <div class="variant-drawer-product-details">
           <div class="vd-product-title">${titleStr}</div>
           <div class="vd-product-options"></div>
           <div class="vd-product-price-wrapper">
             ${
               compareAtPriceStr && parseFloat(compareAtPriceStr) > parseFloat(priceStr)
                 ? `<span class="vd-product-old-price">RM ${compareAtPriceStr}</span>`
                 : ''
             }
             <div class="vd-product-price" style="${
               parseFloat(priceStr) === 0 || (compareAtPriceStr && parseFloat(compareAtPriceStr) > parseFloat(priceStr))
                 ? 'color: #cf2317;'
                 : ''
             }">
               ${parseFloat(priceStr) === 0 ? 'FREE' : `RM ${priceStr}`}
             </div>
           </div>
         </div>
      </div>
      <div class="variant-drawer-select-header">SELECT ${optionName}</div>
    `;

      if (variants && variants.length > 0) {
        const allSamePrice = variants.every((v) => v.price === variants[0].price);

        body.innerHTML =
          productInfoHtml +
          '<div class="variant-option-list">' +
          variants
            .map((variant) => {
              const isAvailable = variant.available;
              const { price: effPrice, discountLabel: dl } = getEffectivePrice(
                variant.id,
                normalizedProductHandle,
                variant.price,
                cart,
                variant.title
              );
              const isDiscounted = effPrice < variant.price;

              return `
          <div class="variant-option-item ${!isAvailable ? 'sold-out' : ''}" 
               ${isAvailable ? `onclick="addVariantToCart(${variant.id}, this)"` : ''}>
            <div class="variant-option-info">
              <div class="variant-option-title">${variant.title}</div>
              ${
                !allSamePrice || isDiscounted
                  ? `
                <div class="variant-option-price-wrapper">
                  ${
                    isDiscounted
                      ? `<span class="variant-option-old-price">RM ${(variant.price / 100).toFixed(2)}</span>`
                      : variant.compare_at_price && variant.compare_at_price > variant.price
                      ? `<span class="variant-option-old-price">RM ${(variant.compare_at_price / 100).toFixed(
                          2
                        )}</span>`
                      : ''
                  }
                  <div class="variant-option-price" style="${isDiscounted || effPrice === 0 ? 'color: #cf2317;' : ''}">
                    ${effPrice === 0 ? 'FREE' : `RM ${(effPrice / 100).toFixed(2)}`}
                  </div>
                </div>
              `
                  : ''
              }
            </div>
            <div class="variant-option-action">
              ${
                isAvailable
                  ? `Add to cart 
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>`
                  : 'Out of stock'
              }
            </div>
          </div>
        `;
            })
            .join('') +
          '</div>';
      } else {
        body.innerHTML = '<div class="variant-drawer-loading">No options available</div>';
      }

      // Open drawer only after content is fully ready
      openVariantDrawer();
    } catch (error) {
      console.error('Error opening extra variant drawer:', error);
    } finally {
      btnElement.innerHTML = originalHtml;
      btnElement.disabled = false;
      normalizeExtraAddButtonLabel(btnElement);
    }
  }

  async function addVariantToCart(variantId, btnElement) {
    if (btnElement) {
      const actionDiv = btnElement.querySelector('.variant-option-action');
      if (actionDiv) {
        actionDiv.innerHTML = '<span class="cart-drawer-spinner cart-drawer-spinner--small"></span>';
      }
    }

    await addExtraToCart(variantId);
    closeVariantDrawer();
  }
</script>
