{% comment %}
  Contact Section
  Displays contact location information and contact form side by side
{% endcomment %}

<style>
  .contact-section {
    background-color: #ffffff;
    padding: 0;
    margin: 0;
  }

  .contact-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .contact-header {
    margin-bottom: 32px;
  }

  .contact-label {
    font-weight: bold;
    color: #111827;
    margin: 0 0 8px 0;
    font-size: 16px;
  }

  .contact-title {
    font-size: 32px;
    font-weight: bold;
    color: #111827;
    margin: 0 0 32px 0;
    line-height: 1.2;
  }

  @media (min-width: 1024px) {
    .contact-title {
      font-size: 40px;
    }
  }

  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      flex-direction: row;
      gap: 56px;
      justify-content: space-between;
    }
  }

  /* Location Section */
  .contact-location {
    width: 100%;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    overflow: hidden;
    background-color: #ffffff;
  }

  .contact-location-map {
    overflow: hidden;
  }

  .contact-location-map a {
    display: block;
    overflow: hidden;
    height: 100%;
  }

  .contact-location-map img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 400px;
    transition: transform 0.3s ease;
    object-fit: cover;
  }

  .contact-location-map a:hover img {
    transform: scale(1.05);
  }

  .contact-location-info {
    padding: 20px 24px;
  }

  .contact-info-item {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    align-items: flex-start;
  }

  .contact-info-item:last-child {
    margin-bottom: 0;
  }

  .contact-info-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 4px;
    color: #000000;
  }

  .contact-info-text {
    font-size: 16px;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }

  .contact-info-text strong {
    font-weight: 600;
    color: #111827;
  }

  .contact-info-text .company-name {
    font-weight: 600;
    color: #111827;
  }

  .contact-info-text .company-reg {
    font-size: 14px;
    color: #6b7280;
  }

  /* Form Section */
  .contact-form-wrapper {
    width: 100%;
    max-width: 512px;
  }

  @media (min-width: 768px) {
    .contact-form-wrapper {
      max-width: 672px;
    }
  }

  @media (min-width: 1024px) {
    .contact-form-wrapper {
      max-width: 768px;
    }
  }

  .contact-form-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
  }

  @media (min-width: 1024px) {
    .contact-form-title {
      font-size: 28px;
    }
  }

  .contact-form-description {
    margin: 0 0 24px 0;
    font-size: 16px;
    color: #4b5563;
    line-height: 23px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .form-row {
      flex-direction: row;
    }
  }

  .form-group {
    flex: 1;
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 8px 0;
  }

  .form-label .required {
    color: #ef4444;
  }

  .form-input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    background-color: #f9fafb;
    color: #111827;
    font-size: 16px;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .form-input:focus {
    border-color: #cf2317;
    background-color: #ffffff;
    outline: 0;
  }

  .form-input::placeholder {
    color: #9ca3af;
  }

  .form-input-icon-wrapper {
    position: relative;
  }

  .form-input-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: #9ca3af;
    pointer-events: none;
  }

  .form-input-with-icon {
    padding-left: 44px;
  }

  .form-textarea {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    background-color: #f9fafb;
    color: #111827;
    font-size: 16px;
    transition: all 0.3s ease;
    resize: none;
    font-family: inherit;
    box-sizing: border-box;
  }

  .form-textarea:focus {
    border-color: #cf2317;
    background-color: #ffffff;
    outline: 0;
  }

  .form-textarea::placeholder {
    color: #9ca3af;
  }

  .form-submit-wrapper {
    padding-top: 8px;
    margin: 0;
  }

  .form-submit-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 32px;
    background-color: #cf2317;
    color: #ffffff;
    font-weight: bold;
    font-size: 16px;
    border: 0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .form-submit-button:hover {
    background-color: #111827;
  }

  .form-submit-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .form-submit-button:hover .form-submit-icon {
    transform: translateX(4px);
  }

  .form-success-message {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 2px solid #bbf7d0;
    background-color: #f0fdf4;
    border-radius: 12px;
    margin-top: 16px;
  }

  .form-success-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #16a34a;
  }

  .form-success-title {
    font-weight: 600;
    color: #166534;
    margin: 0 0 4px 0;
    font-size: 16px;
  }

  .form-success-text {
    font-size: 14px;
    color: #15803d;
    margin: 0;
  }
</style>

<div class="contact-section">
  <div class="contact-container">
    <!-- Header -->
    <div class="contact-header">
      <h3 class="contact-label">{{ section.settings.label }}</h3>
      <h2 class="contact-title">{{ section.settings.title }}</h2>
    </div>

    <div class="contact-layout">
      <!-- Location Info -->
      <div class="contact-location">
        <!-- Map Image -->
        <div class="contact-location-map">
          <a href="{{ section.settings.map_link }}" target="_blank" rel="noopener noreferrer">
            {% if section.settings.map_image %}
              <img
                src="{{ section.settings.map_image | img_url: '800x' }}"
                alt="Onthego Location Map"
                width="480"
                height="240"
                loading="lazy"
              >
            {% endif %}
          </a>
        </div>

        <!-- Company Information -->
        <div class="contact-location-info">
          <!-- Company Name -->
          <div class="contact-info-item">
            <div class="contact-info-text">
              <span class="company-name">{{ section.settings.company_name }}</span>
              <span class="company-reg">({{ section.settings.company_registration }})</span>
            </div>
          </div>

          <!-- Address -->
          <div class="contact-info-item">
            <svg class="contact-info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="contact-info-text">
              {{ section.settings.address }}
            </p>
          </div>

          <!-- Email -->
          <div class="contact-info-item">
            <svg class="contact-info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <p class="contact-info-text">
              <a href="mailto:{{ section.settings.email }}" style="color: #4b5563; text-decoration: none;">
                {{- section.settings.email -}}
              </a>
            </p>
          </div>

          <!-- Phone -->
          <div class="contact-info-item">
            <svg class="contact-info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <p class="contact-info-text">
              <a href="tel:{{ section.settings.phone }}" style="color: #4b5563; text-decoration: none;">
                {{- section.settings.phone -}}
              </a>
            </p>
          </div>

          <!-- Business Hours -->
          <div class="contact-info-item">
            <svg class="contact-info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div class="contact-info-text">
              <p style="margin: 0;">
                {{ section.settings.hours_weekday_label }}: <strong>{{ section.settings.hours_weekday }}</strong>
              </p>
              <p style="margin: 0;">
                {{ section.settings.hours_weekend_label }}: <strong>{{ section.settings.hours_weekend }}</strong>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrapper">
        <h2 class="contact-form-title">{{ section.settings.form_title }}</h2>
        <p class="contact-form-description">{{ section.settings.form_description }}</p>

        {% form 'contact' %}
          <div class="contact-form">
            <!-- First Name and Last Name -->
            <div class="form-row">
              <div class="form-group">
                <label for="contact-first-name" class="form-label">
                  {{ section.settings.first_name_label -}}
                  <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="contact-first-name"
                  name="contact[first_name]"
                  class="form-input"
                  required
                >
              </div>

              <div class="form-group">
                <label for="contact-last-name" class="form-label">
                  {{ section.settings.last_name_label -}}
                  <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="contact-last-name"
                  name="contact[last_name]"
                  class="form-input"
                  required
                >
              </div>
            </div>

            <!-- Email -->
            <div class="form-group">
              <label for="contact-email" class="form-label">
                {{ section.settings.email_label -}}
                <span class="required">*</span>
              </label>
              <div class="form-input-icon-wrapper">
                <svg class="form-input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <input
                  type="email"
                  id="contact-email"
                  name="contact[email]"
                  class="form-input form-input-with-icon"
                  placeholder="{{ section.settings.email_placeholder }}"
                  required
                >
              </div>
            </div>

            <!-- Phone -->
            <div class="form-group">
              <label for="contact-phone" class="form-label">
                {{ section.settings.phone_label -}}
                <span class="required">*</span>
              </label>
              <div class="form-input-icon-wrapper">
                <svg class="form-input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <input
                  type="tel"
                  id="contact-phone"
                  name="contact[phone]"
                  class="form-input form-input-with-icon"
                  placeholder="{{ section.settings.phone_placeholder }}"
                  required
                >
              </div>
            </div>

            <!-- Message -->
            <div class="form-group">
              <label for="contact-message" class="form-label">
                {{ section.settings.message_label }}
              </label>
              <textarea
                id="contact-message"
                name="contact[body]"
                rows="5"
                class="form-textarea"
                placeholder="{{ section.settings.message_placeholder }}"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="form-submit-wrapper">
              <button type="submit" class="form-submit-button">
                {{ section.settings.submit_button_text }}
                <svg class="form-submit-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </button>
            </div>

            <!-- Success Message -->
            {% if form.posted_successfully? %}
              <div class="form-success-message">
                <svg class="form-success-icon" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <p class="form-success-title">{{ section.settings.success_title }}</p>
                  <p class="form-success-text">{{ section.settings.success_message }}</p>
                </div>
              </div>
            {% endif %}
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "WHO WE ARE"
    },
    {
      "type": "header",
      "content": "Location Settings"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Map Image"
    },
    {
      "type": "text",
      "id": "map_link",
      "label": "Google Maps Link",
      "default": "https://maps.app.goo.gl/ARoLpXVyN9SF3oqe6"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company Name",
      "default": "Onthego F&B Industry Sdn. Bhd."
    },
    {
      "type": "text",
      "id": "company_registration",
      "label": "Company Registration",
      "default": "1581768-H"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Salak Perdana Business Park, 18, Jalan Kenanga 1/6, Bandar Baru Salak Tinggi, 43900 Sepang, Selangor"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "info@onthego.com.my"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+60 3-8787 0088"
    },
    {
      "type": "text",
      "id": "hours_weekday_label",
      "label": "Weekday Hours Label",
      "default": "Mon – Fri"
    },
    {
      "type": "text",
      "id": "hours_weekday",
      "label": "Weekday Hours",
      "default": "9am – 5:30pm"
    },
    {
      "type": "text",
      "id": "hours_weekend_label",
      "label": "Weekend Hours Label",
      "default": "Sat – Sun"
    },
    {
      "type": "text",
      "id": "hours_weekend",
      "label": "Weekend Hours",
      "default": "Closed"
    },
    {
      "type": "header",
      "content": "Contact Form Settings"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title",
      "default": "Send us a Message"
    },
    {
      "type": "text",
      "id": "form_description",
      "label": "Form Description",
      "default": "Fill out the form below and we'll get back to you soon."
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First Name Label",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last Name Label",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "your.email@example.com"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone Placeholder",
      "default": "+60 12-345 6789"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message Label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message Placeholder",
      "default": "Tell us more about your inquiry..."
    },
    {
      "type": "text",
      "id": "submit_button_text",
      "label": "Submit Button Text",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success Message Title",
      "default": "Message sent successfully!"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message Text",
      "default": "We'll get back to you soon."
    }
  ],
  "presets": [
    {
      "name": "Contact Section"
    }
  ]
}
{% endschema %}
