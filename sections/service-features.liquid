{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .service-features__list {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
    scrollbar-width: none; /* Firefox */
  }

  .service-features__item {
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding: 1rem 2rem;
    text-align: left;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    border-radius: var(--media-radius);
  }

  .service-features__icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .service-features__icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .service-features__progress {
    display: block !important;
    width: 100%;
    max-width: 200px;
    height: 8px;
    background-color: #e5e5e5;
    margin: 2rem auto 0;
    position: relative;
    border-radius: 4px;
    overflow: visible;
    border: 1px solid #ccc;
  }

  .service-features__progress-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    background-color: #000000 !important;
    width: 33%;
    transition: width 0.2s ease-out;
    border-radius: 4px;
    z-index: 10;
  }

  @media screen and (min-width: 750px) {
    .service-features__list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      flex-wrap: wrap;
      overflow-x: visible;
      gap: 1.5rem;
    }

    .service-features__item {
      flex: 1;
      width: auto;
      scroll-snap-align: unset;
      flex-direction: column;
      text-align: center;
      padding: 1.5rem 1rem;
      gap: 0.5rem;
    }

    .service-features__icon {
      margin-bottom: 0.5rem;
    }

    .service-features__text {
      white-space: nowrap;
    }

    .service-features__text strong {
      white-space: nowrap;
      display: inline;
    }
  }
{%- endstyle -%}

<style>
  .sf-progress-{{ section.id }} {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    width: 100% !important;
    max-width: 200px !important;
    height: 4px !important;
    background-color: #e5e5e5 !important;
    margin: 10px auto 0 !important;
    position: relative !important;
    border-radius: 4px !important;
  }
  .sf-progress-bar-{{ section.id }} {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    height: 100% !important;
    background-color: #000 !important;
    width: 25%;
    border-radius: 4px !important;
    z-index: 10 !important;
    transition: width 0.3s ease-out !important;
  }
  @media screen and (min-width: 750px) {
    .sf-progress-{{ section.id }} {
      display: none !important;
    }
  }
</style>

<div class="service-features section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="service-features__wrapper">
      <ul class="service-features__list" id="ServiceFeaturesList-{{ section.id }}">
        {%- for block in section.blocks -%}
          <li class="service-features__item" {{ block.shopify_attributes }}>
            <div class="service-features__icon">
              {%- if block.settings.icon_svg != blank -%}
                {{ block.settings.icon_svg }}
              {%- endif -%}
            </div>
            {%- if block.settings.text != blank -%}
              <div class="service-features__text rte">
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="sf-progress-{{ section.id }}" aria-hidden="true">
        <div class="sf-progress-bar-{{ section.id }}" id="ServiceFeaturesProgress-{{ section.id }}"></div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initServiceFeatures() {
      const list = document.getElementById('ServiceFeaturesList-{{ section.id }}');
      const progressBar = document.getElementById('ServiceFeaturesProgress-{{ section.id }}');

      if (!list || !progressBar) return;

      const items = list.querySelectorAll('.service-features__item');
      const totalItems = items.length || 4;

      function updateProgress() {
        const scrollLeft = list.scrollLeft;
        const clientWidth = list.clientWidth; // Width of one item (100% of container)

        // Calculate current slide index (0-based)
        // Each item takes full width, so scrollLeft / clientWidth gives us the index
        const currentIndex = Math.round(scrollLeft / clientWidth);

        // Calculate percentage: (currentIndex + 1) / totalItems * 100
        // So for 4 items: 25%, 50%, 75%, 100%
        let percentage = ((currentIndex + 1) / totalItems) * 100;
        percentage = Math.max(25, Math.min(percentage, 100));

        progressBar.style.setProperty('width', percentage + '%', 'important');
      }

      // Use scroll event with passive option for better performance
      list.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);

      // Initial call
      setTimeout(updateProgress, 100);
      updateProgress();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initServiceFeatures);
    } else {
      initServiceFeatures();
    }

    // Init on Theme Editor section re-load
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initServiceFeatures();
      }
    });
  })();
</script>

