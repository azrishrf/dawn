      <span class="mobile-menu-title"></span>
      <button
        onclick="closeMobileMenu()"
        class="mobile-menu-close"
        aria-label="Close menu"
      >
        <svg class="icon-svg" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
