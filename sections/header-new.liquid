{% comment %}
  Header Section
  Main navigation header with mobile menu drawer
{% endcomment %}

<style>
  .header-wrapper {
    width: 100%;
    z-index: 100;
    transition: all 0.3s ease;
  }

  .header-wrapper.header-absolute {
    position: fixed;
    top: 0;
    left: 0;
    background-color: transparent;
    color: white;
  }

  .header-wrapper.header-absolute.scrolled {
    background-color: white;
    color: black;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .header-wrapper.header-absolute.scrolled .nav-link {
    color: black;
  }

  .header-wrapper.header-absolute.scrolled .nav-link::after {
    background-color: black;
  }

  .header-wrapper.header-absolute.scrolled .icon-btn {
    color: black;
  }

  .header-wrapper.header-absolute.scrolled .mobile-menu-btn {
    color: black;
  }

  .header-wrapper.header-absolute-red {
    position: relative;
    background-color: #cf2317;
    color: white;
  }

  .header-wrapper.header-absolute-red.scrolled {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: #cf2317;
    color: white;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .header-spacer {
    display: none;
  }

  .header-spacer.active {
    display: block;
    height: 70px;
  }

  @media (min-width: 1024px) {
    .header-spacer.active {
      height: 90px;
    }
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 1024px) {
    .header-container {
      padding: 0 3rem;
      height: 90px;
    }
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: block;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
  }

  .mobile-menu-btn:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }

  @media (min-width: 1280px) {
    .desktop-nav {
      gap: 2.5rem;
    }
  }

  .nav-link {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    position: relative;
    padding: 0.5rem 0;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .header-absolute .nav-link,
  .header-absolute-red .nav-link {
    color: white;
  }

  .header-absolute-red .nav-link:hover {
    color: white;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    transition: all 0.3s ease;
  }

  .header-absolute .nav-link::after,
  .header-absolute-red .nav-link::after {
    background-color: white;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Logo */
  .logo-wrapper {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.logo_width_mobile }}px;
  }

  @media (min-width: 1024px) {
    .logo-wrapper {
      width: {{ section.settings.logo_width }}px;
    }
  }

  .logo-link {
    display: block;
    position: relative;
    height: 40px;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: all 0.5s ease;
    position: absolute;
    top: 0;
    left: 0;
  }



  .logo-scrolled {
    opacity: 0;
    visibility: hidden;
  }

  .header-wrapper.header-absolute.scrolled .has-scrolled-logo .logo-default {
    opacity: 0;
    visibility: hidden;
  }

  .header-wrapper.header-absolute.scrolled .has-scrolled-logo .logo-scrolled {
    opacity: 1;
    visibility: visible;
  }

  /* Icons */
  .header-icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    position: relative;
  }

  .icon-btn:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }

  .icon-btn-user {
    display: none;
  }

  @media (min-width: 640px) {
    .icon-btn-user {
      display: flex;
    }
  }

  .cart-badge {
    position: absolute;
    top: -0.125rem;
    right: -0.125rem;
    display: flex;
    height: 1.25rem;
    width: 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: #fbbf24;
    font-size: 0.688rem;
    font-weight: 700;
    color: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border: 2px solid white;
    transition: transform 0.3s ease;
  }

  .icon-btn:hover .cart-badge {
    transform: scale(1.1);
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 105;
    transition: opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }

  .mobile-menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .mobile-menu-drawer {
    position: relative;
    background-color: white;
    width: 320px;
    height: 100%;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-menu-overlay.active .mobile-menu-drawer {
    transform: translateX(0);
  }

  .mobile-menu-header {
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e5e7eb;
    background: linear-gradient(to right, #f9fafb, white);
  }

  .mobile-menu-title {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }

  .mobile-menu-close {
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    color: black;
  }

  .mobile-menu-close:hover {
    background-color: #e5e7eb;
  }

  .mobile-menu-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-item {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 1rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    border-bottom: 1px solid #f3f4f6;
    text-decoration: none;
    color: inherit;
    opacity: 0;
    transform: translateX(-20px);
  }

  .mobile-menu-overlay.active .mobile-nav-item {
    animation: slideInLeft 0.4s ease forwards;
  }

  .mobile-menu-overlay.active .mobile-nav-item:nth-child(1) {
    animation-delay: 0.1s;
  }

  .mobile-menu-overlay.active .mobile-nav-item:nth-child(2) {
    animation-delay: 0.2s;
  }

  .mobile-menu-overlay.active .mobile-nav-item:nth-child(3) {
    animation-delay: 0.3s;
  }

  .mobile-menu-overlay.active .mobile-nav-item:nth-child(4) {
    animation-delay: 0.4s;
  }

  .mobile-menu-overlay.active .mobile-nav-item:nth-child(5) {
    animation-delay: 0.5s;
  }

  @keyframes slideInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .mobile-nav-item:hover {
    background-color: #f3f4f6;
    border-color: transparent;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .mobile-menu-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    {% comment %} border-top: 1px solid #e5e7eb; {% endcomment %}
  }

  .mobile-login-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.5rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .mobile-login-link:hover {
    background-color: #f3f4f6;
  }

  /* SVG Icons */
  .icon-svg {
    display: block;
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .icon-svg-small {
    width: 30px;
    height: 30px;
    {% comment %} stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none; {% endcomment %}
  }

  /* Cart Drawer Styles */
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer-overlay.active {
    pointer-events: auto;
    opacity: 1;
  }

  .cart-drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .cart-drawer {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 400px;
    max-width: 90vw;
    background-color: #fff;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .cart-drawer-overlay.active .cart-drawer {
    transform: translateX(0);
  }

  .cart-drawer-header {
    padding: 24px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(to bottom, #f9fafb, #fff);
  }

  .cart-drawer-title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .cart-drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 4px;
    transition: background-color 0.3s ease;
    color: #000;
  }

  .cart-drawer-close:hover {
    background-color: #f3f4f6;
  }

  .cart-drawer-items {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .cart-drawer-item {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #f3f4f6;
  }

  .cart-drawer-item:last-child {
    border-bottom: none;
  }

  .cart-item-image {
    width: 80px;
    height: 100px;
    object-fit: cover;
    background-color: #f9fafb;
    flex-shrink: 0;
  }

  .cart-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cart-item-title {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.4;
  }

  .cart-item-variant {
    font-size: 12px;
    color: #6b7280;
  }

  .cart-item-quantity {
    font-size: 12px;
    color: #6b7280;
  }

  .cart-item-price {
    font-weight: 600;
    font-size: 14px;
  }

  .cart-drawer-empty {
    text-align: center;
    padding: 48px 24px;
    color: #6b7280;
  }

  .cart-drawer-footer {
    padding: 24px;
    border-top: 2px solid #e5e7eb;
    background-color: #f9fafb;
  }

  .cart-drawer-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
  }
!-- Cart Drawer -->
<div class="cart-drawer-overlay" id="cartDrawer">
  <div class="cart-drawer-backdrop" onclick="closeCartDrawer()"></div>
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-title">YOUR CART</h2>
      <button onclick="closeCartDrawer()" class="cart-drawer-close" aria-label="Close cart">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="cart-drawer-items" id="cartDrawerItems">
      <div class="cart-drawer-empty">Your cart is empty</div>
    </div>
    <div class="cart-drawer-footer">
      <div class="cart-drawer-total">
        <span>SUBTOTAL:</span>
        <span id="cartDrawerTotal">RM 0.00</span>
      </div>
      <a href="/cart" class="cart-drawer-button cart-drawer-view">VIEW CART</a>
      <a href="/checkout" class="cart-drawer-button cart-drawer-checkout">CHECKOUT</a>
    </div>
  </div>
</div>

<
