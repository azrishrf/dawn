</style>

<div class="header-spacer" id="headerSpacer"></div>
<div
  class="header-wrapper {% if template == 'index' %}header-absolute{% else %}header-absolute-red{% endif %}"
  id="mainHeader"
>
  <div class="header-container">
    <!-- Mobile Menu Trigger -->
    <button
      class="mobile-menu-btn"
      onclick="openMobileMenu()"
      aria-label="Open menu"
    >
      <svg class="icon-svg" viewBox="0 0 24 24">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Desktop Nav - Left -->
    <nav class="desktop-nav">
      {% for block in section.blocks %}
        {% if forloop.index <= 4 %}
          <a
            href="{{ block.settings.link }}"
            class="nav-link"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- Logo -->
    <div class="logo-wrapper">
      <a href="/" class="logo-link {% if section.settings.logo_scrolled %}has-scrolled-logo{% endif %}">
        {% if section.settings.logo %}
          {% assign image_size_2x = section.settings.logo_width | times: 2 | at_most: 5760 %}
          {{
            section.settings.logo
            | image_url: width: image_size_2x
            | image_tag: class: 'logo-img logo-default', alt: shop.name
          }}

          {% if section.settings.logo_scrolled %}
            {{
              section.settings.logo_scrolled
              | image_url: width: image_size_2x
              | image_tag: class: 'logo-img logo-scrolled', alt: shop.name
            }}
          {% endif %}
        {% else %}
          <span class="h2">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Icons - Right -->
    <div class="header-icons">
      <a
        href="/account"
        class="icon-btn icon-btn-user"
        aria-label="Account"
      >
        <svg class="icon-svg" viewBox="0 0 24 24">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <button class="icon-btn" onclick="openSearch()" aria-label="Search">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      <button
        class="icon-btn"
        onclick="openCartDrawer(event)"
        aria-label="Shopping cart"
      >
        <svg class="icon-svg" viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-badge" id="cartCount">{{ cart.item_count }}</span>
        {% endif %}
      </button>
    </div>
  </div>
</div>

<!-- Mobile Menu Drawer -->
