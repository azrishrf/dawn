          {% comment %} <svg class="icon-svg-small" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="#5c5c5c" stroke="#5c5c5c"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path fill="none" d="M0 0h24v24H0z"></path> <path d="M12 2c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zM6.023 15.416C7.491 17.606 9.695 19 12.16 19c2.464 0 4.669-1.393 6.136-3.584A8.968 8.968 0 0 0 12.16 13a8.968 8.968 0 0 0-6.137 2.416zM12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path> </g> </g></svg> {% endcomment %}
          <svg
            class="icon-svg-small"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            fill="#5c5c5c"
            stroke="#5c5c5c"
          >
            <path d="M12 2c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zM6.023 15.416C7.491 17.606 9.695 19 12.16 19c2.464 0 4.669-1.393 6.136-3.584A8.968 8.968 0 0 0 12.16 13a8.968 8.968 0 0 0-6.137 2.416zM12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path>
          </svg>

          <span>
            {%- if customer %}MY ACCOUNT{% else %}Login / Register{% endif -%}
          </span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function openMobileMenu() {
    document.getElementById('mobileMenu').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    document.getElementById('mobileMenu').classList.remove('active');
    document.body.style.overflow = '';
  }

  function openSearch() {
    // Implement search functionality or redirect to search page
    window.location.href = '/search';
  }

  function openCartDrawer(event) {
    event.preventDefault();
    const drawer = document.getElementById('cartDrawer');
    if (drawer) {
      drawer.classList.add('active');
      document.body.style.overflow = 'hidden';
      updateCartDrawer();
    }
  }

  function closeCartDrawer() {
    const drawer = document.getElementById('cartDrawer');
    if (drawer) {
      drawer.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  async function updateCartDrawer() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();

      const itemsContainer = document.getElementById('cartDrawerItems');
      const totalElement = document.getElementById('cartDrawerTotal');

      if (!itemsContainer || !totalElement) return;

      if (cart.items.length === 0) {
        itemsContainer.innerHTML = '<div class="cart-drawer-empty">Your cart is empty</div>';
      } else {
        itemsContainer.innerHTML = cart.items
          .map(
            (item) => `
          <div class="cart-drawer-item">
            <img src="${item.image}" alt="${item.title}" class="cart-item-image">
            <div class="cart-item-details">
              <div class="cart-item-title">${item.title}</div>
              ${item.variant_title ? `<div class="cart-item-variant">${item.variant_title}</div>` : ''}
              <div class="cart-item-quantity">Qty: ${item.quantity}</div>
              <div class="cart-item-price">RM ${(item.line_price / 100).toFixed(2)}</div>
            </div>
          </div>
        `
          )
          .join('');
      }

      totalElement.textContent = `RM ${(cart.total_price / 100).toFixed(2)}`;

      // Update header cart count
      const cartCountElement = document.getElementById('cartCount');
      if (cartCountElement) {
        cartCountElement.textContent = cart.item_count;
        cartCountElement.style.display = cart.item_count > 0 ? 'flex' : 'none';
      }
    } catch (error) {
      console.error('Error updating cart drawer:', error);
    }
  }

  // Update cart count dynamically
  document.addEventListener('DOMContentLoaded', function () {
    // Listen for cart updates
    document.addEventListener('cart:updated', function (event) {
      var cartCount = event.detail.itemCount || 0;
      var cartBadge = document.getElementById('cartCount');

      if (cartCount > 0) {
        if (!cartBadge) {
          // Create badge if it doesn't exist
          cartBadge = document.createElement('span');
          cartBadge.id = 'cartCount';
          cartBadge.className = 'cart-badge';
          var cartButton = document.querySelector('.icon-btn[aria-label="Shopping cart"]');
          if (cartButton) {
            cartButton.appendChild(cartBadge);
          }
        }
        cartBadge.textContent = cartCount;
        cartBadge.style.display = 'flex';
      } else if (cartBadge) {
        cartBadge.style.display = 'none';
      }
    });

    // Handle scroll effect for all pages
    var header = document.getElementById('mainHeader');
    var headerSpacer = document.getElementById('headerSpacer');
    var isRedHeader = header.classList.contains('header-absolute-red');

    if (header && (header.classList.contains('header-absolute') || isRedHeader)) {
      window.addEventListener('scroll', function () {
        if (window.scrollY > 50) {
          header.classList.add('scrolled');
          if (isRedHeader && headerSpacer) {
            headerSpacer.classList.add('active');
          }
        } else {
          header.classList.remove('scrolled');
          if (isRedHeader && headerSpacer) {
            headerSpacer.classList.remove('active');
          }
        }
      });
    }
  });
</script>

