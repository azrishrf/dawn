{% comment %}
  Header Section
  Main navigation header with mobile menu drawer
{% endcomment %}

<style>
  .header-wrapper {
    width: 100%;
    z-index: 100;
    transition: all 0.3s ease;
  }

  .header-wrapper.header-absolute {
    position: fixed;
    top: 0;
    left: 0;
    background-color: transparent;
    color: white;
  }

  .header-wrapper.header-absolute.scrolled {
    background-color: white;
    color: black;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .header-wrapper.header-absolute.scrolled .nav-link {
    color: black;
  }

  .header-wrapper.header-absolute.scrolled .nav-link::after {
    background-color: black;
  }

  .header-wrapper.header-absolute.scrolled .icon-btn {
    color: black;
  }

  .header-wrapper.header-absolute.scrolled .mobile-menu-btn {
    color: black;
  }

  .header-wrapper.header-absolute-red {
    position: relative;
    background-color: #cf2317;
    color: white;
  }

  .header-wrapper.header-absolute-red.scrolled {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: #cf2317;
    color: white;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    animation: slideDown 0.3s ease;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .header-spacer {
    display: none;
  }

  .header-spacer.active {
    display: block;
    height: 70px;
  }

  @media (min-width: 1024px) {
    .header-spacer.active {
      height: 90px;
    }
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 1024px) {
    .header-container {
      padding: 0 30px;
      height: 90px;
    }
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: block;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
  }

  .mobile-menu-btn:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }

  @media (min-width: 1280px) {
    .desktop-nav {
      gap: 2.5rem;
    }
  }

  .nav-link {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    position: relative;
    padding: 0.5rem 0;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .header-absolute .nav-link,
  .header-absolute-red .nav-link {
    color: white;
  }

  .header-absolute-red .nav-link:hover {
    color: white;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    transition: all 0.3s ease;
  }

  .header-absolute .nav-link::after,
  .header-absolute-red .nav-link::after {
    background-color: white;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Logo */
  .logo-wrapper {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.logo_width_mobile }}px;
  }

  @media (min-width: 1024px) {
    .logo-wrapper {
      width: {{ section.settings.logo_width }}px;
    }
  }

  .logo-link {
    display: block;
    position: relative;
    height: 40px;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: all 0.5s ease;
    position: absolute;
    top: 0;
    left: 0;
  }



  .logo-scrolled {
    opacity: 0;
    visibility: hidden;
  }

  .header-wrapper.header-absolute.scrolled .has-scrolled-logo .logo-default {
    opacity: 0;
    visibility: hidden;
  }

  .header-wrapper.header-absolute.scrolled .has-scrolled-logo .logo-scrolled {
    opacity: 1;
    visibility: visible;
  }

  /* Icons */
  .header-icons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    position: relative;
  }

  .icon-btn:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }

  .icon-btn-user {
    display: none;
  }

  @media (min-width: 640px) {
    .icon-btn-user {
      display: flex;
    }
  }

  .cart-badge {
    position: absolute;
    top: -0.125rem;
    right: -0.125rem;
    display: flex;
    height: 1.25rem;
    width: 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: #fbbf24;
    font-size: 0.688rem;
    font-weight: 700;
    color: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border: 2px solid white;
    transition: transform 0.3s ease;
  }

  .icon-btn:hover .cart-badge {
    transform: scale(1.1);
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 105;
    transition: opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }

  .mobile-menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .mobile-menu-drawer {
    position: relative;
    background-color: white;
    width: 320px;
    height: 100%;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-menu-overlay.active .mobile-menu-drawer {
    transform: translateX(0);
  }

  .mobile-menu-header {
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e5e7eb;
    background: linear-gradient(to right, #f9fafb, white);
  }

  .mobile-menu-title {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }

  .mobile-menu-close {
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    color: black;
  }

  .mobile-menu-close:hover {
    background-color: #e5e7eb;
  }

  .mobile-menu-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-item {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 1rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    border-bottom: 1px solid #f3f4f6;
    text-decoration: none;
    color: inherit;
    opacity: 0;
    transform: translateX(-20px);
  }

  .mobile-menu-overlay.active .mobile-nav-item {
    animation: slideInLeft 0.4s ease forwards;
  }

  .mobile-menu-overlay.active .mobile-nav-item:nth-child(1) { animation-delay: 0.1s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(2) { animation-delay: 0.2s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(3) { animation-delay: 0.3s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(4) { animation-delay: 0.4s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(5) { animation-delay: 0.5s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(6) { animation-delay: 0.6s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(7) { animation-delay: 0.7s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(8) { animation-delay: 0.8s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(9) { animation-delay: 0.9s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(10) { animation-delay: 1s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(11) { animation-delay: 1.5s; }
  .mobile-menu-overlay.active .mobile-nav-item:nth-child(12) { animation-delay: 2s; }

  @keyframes slideInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .mobile-nav-item:hover {
    background-color: #f3f4f6;
    border-color: transparent;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .mobile-menu-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    {% comment %} border-top: 1px solid #e5e7eb; {% endcomment %}
  }

  .mobile-login-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.5rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .mobile-login-link:hover {
    background-color: #f3f4f6;
  }

  /* SVG Icons */
  .icon-svg {
    display: block;
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .icon-svg-small {
    width: 30px;
    height: 30px;
    {% comment %} stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none; {% endcomment %}
  }
</style>

<div class="header-spacer" id="headerSpacer"></div>
<div
  class="header-wrapper {% if template == 'index' %}header-absolute{% else %}header-absolute-red{% endif %}"
  id="mainHeader"
>
  <div class="header-container">
    <!-- Mobile Menu Trigger -->
    <button
      class="mobile-menu-btn"
      onclick="openMobileMenu()"
      aria-label="Open menu"
    >
      <svg class="icon-svg" viewBox="0 0 24 24">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Desktop Nav - Left -->
    <nav class="desktop-nav">
      {% for block in section.blocks %}
        {% if block.settings.show_desktop %}
          <a
            href="{{ block.settings.link }}"
            class="nav-link"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- Logo -->
    <div class="logo-wrapper">
      <a href="/" class="logo-link {% if section.settings.logo_scrolled %}has-scrolled-logo{% endif %}">
        {% if section.settings.logo %}
          {% assign image_size_2x = section.settings.logo_width | times: 2 | at_most: 5760 %}
          {{
            section.settings.logo
            | image_url: width: image_size_2x
            | image_tag: class: 'logo-img logo-default', alt: shop.name
          }}

          {% if section.settings.logo_scrolled %}
            {{
              section.settings.logo_scrolled
              | image_url: width: image_size_2x
              | image_tag: class: 'logo-img logo-scrolled', alt: shop.name
            }}
          {% endif %}
        {% else %}
          <span class="h2">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Icons - Right -->
    <div class="header-icons">
      <a
        href="/account"
        class="icon-btn icon-btn-user"
        aria-label="Account"
      >
        <svg class="icon-svg" viewBox="0 0 24 24">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <button class="icon-btn" onclick="openSearch()" aria-label="Search">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      <button
        class="icon-btn"
        aria-label="Shopping cart"
        onclick="openCartDrawer(); updateCartDrawer();"
      >
        <svg class="icon-svg" viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-badge" id="cartCount">{{ cart.item_count }}</span>
        {% endif %}
      </button>
    </div>
  </div>
</div>

<!-- Mobile Menu Drawer -->
<div class="mobile-menu-overlay" id="mobileMenu">
  <div class="mobile-menu-backdrop" onclick="closeMobileMenu()"></div>
  <div class="mobile-menu-drawer">
    <div class="mobile-menu-header">
      <span class="mobile-menu-title"></span>
      <button
        onclick="closeMobileMenu()"
        class="mobile-menu-close"
        aria-label="Close menu"
      >
        <svg class="icon-svg" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="mobile-menu-content">
      <div class="mobile-nav-list">
        {% for block in section.blocks %}
          {% if block.settings.show_mobile %}
            <a href="{{ block.settings.link }}" class="mobile-nav-item">
              {{ block.settings.label }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      <div class="mobile-menu-footer">
        <a href="/account" class="mobile-login-link">
          {% comment %} <svg class="icon-svg-small" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true" focusable="false" role="presentation" class="icon icon-account"><path d="M 16 3 C 8.832031 3 3 8.832031 3 16 C 3 23.167969 8.832031 29 16 29 C 23.167969 29 29 23.167969 29 16 C 29 8.832031 23.167969 3 16 3 Z M 16 5 C 22.085938 5 27 9.914063 27 16 C 27 22.085938 22.085938 27 16 27 C 9.914063 27 5 22.085938 5 16 C 5 9.914063 9.914063 5 16 5 Z M 16 8 C 13.25 8 11 10.25 11 13 C 11 14.515625 11.707031 15.863281 12.78125 16.78125 C 10.53125 17.949219 9 20.300781 9 23 L 11 23 C 11 20.226563 13.226563 18 16 18 C 18.773438 18 21 20.226563 21 23 L 23 23 C 23 20.300781 21.46875 17.949219 19.21875 16.78125 C 20.292969 15.863281 21 14.515625 21 13 C 21 10.25 18.75 8 16 8 Z M 16 10 C 17.667969 10 19 11.332031 19 13 C 19 14.667969 17.667969 16 16 16 C 14.332031 16 13 14.667969 13 13 C 13 11.332031 14.332031 10 16 10 Z"></path></svg> {% endcomment %}
          {% comment %} <svg class="icon-svg-small" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="#5c5c5c" stroke="#5c5c5c"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path fill="none" d="M0 0h24v24H0z"></path> <path d="M12 2c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zM6.023 15.416C7.491 17.606 9.695 19 12.16 19c2.464 0 4.669-1.393 6.136-3.584A8.968 8.968 0 0 0 12.16 13a8.968 8.968 0 0 0-6.137 2.416zM12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path> </g> </g></svg> {% endcomment %}
          <svg
            class="icon-svg-small"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            fill="#5c5c5c"
            stroke="#5c5c5c"
          >
            <path d="M12 2c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zM6.023 15.416C7.491 17.606 9.695 19 12.16 19c2.464 0 4.669-1.393 6.136-3.584A8.968 8.968 0 0 0 12.16 13a8.968 8.968 0 0 0-6.137 2.416zM12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path>
          </svg>

          <span>
            {%- if customer %}MY ACCOUNT{% else %}Login / Register{% endif -%}
          </span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function openMobileMenu() {
    document.getElementById('mobileMenu').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    document.getElementById('mobileMenu').classList.remove('active');
    document.body.style.overflow = '';
  }

  function openSearch() {
    // Implement search functionality or redirect to search page
    window.location.href = '/search';
  }

  // Update cart count dynamically
  document.addEventListener('DOMContentLoaded', function () {
    // Listen for cart updates
    document.addEventListener('cart:updated', function (event) {
      var cartCount = event.detail.itemCount || 0;
      var cartBadge = document.getElementById('cartCount');

      if (cartCount > 0) {
        if (!cartBadge) {
          // Create badge if it doesn't exist
          cartBadge = document.createElement('span');
          cartBadge.id = 'cartCount';
          cartBadge.className = 'cart-badge';
          document.querySelector('.icon-btn[aria-label="Shopping cart"]').appendChild(cartBadge);
        }
        cartBadge.textContent = cartCount;
        cartBadge.style.display = 'flex';
      } else if (cartBadge) {
        cartBadge.style.display = 'none';
      }
    });

    // Handle scroll effect for all pages
    var header = document.getElementById('mainHeader');
    var headerSpacer = document.getElementById('headerSpacer');
    var isRedHeader = header.classList.contains('header-absolute-red');

    if (header && (header.classList.contains('header-absolute') || isRedHeader)) {
      window.addEventListener('scroll', function () {
        if (window.scrollY > 50) {
          header.classList.add('scrolled');
          if (isRedHeader && headerSpacer) {
            headerSpacer.classList.add('active');
          }
        } else {
          header.classList.remove('scrolled');
          if (isRedHeader && headerSpacer) {
            headerSpacer.classList.remove('active');
          }
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "image_picker",
      "id": "logo_scrolled",
      "label": "Scrolled Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px",
      "label": "Logo Width (Desktop)"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 140,
      "unit": "px",
      "label": "Logo Width (Mobile)"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "MENU ITEM"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_mobile",
          "label": "Show in Mobile Menu",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_desktop",
          "label": "Show in Desktop Menu",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "nav_item",
          "settings": {
            "label": "SUPPLEMENTS",
            "link": "/collections/supplements"
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "APPAREL",
            "link": "/collections/apparel"
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "LIFTING GEAR",
            "link": "/collections/lifting-gear"
          }
        },
        {
          "type": "nav_item",
          "settings": {
            "label": "MERCH",
            "link": "/collections/merch"
          }
        }
      ]
    }
  ]
}
{% endschema %}
