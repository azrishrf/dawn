  "name": "Product Main Seasonings",
  "tag": "section",
  "class": "product-main-seasonings-section",
  "settings": [
    {
      "type": "header",
      "content": "Pack Option Images"
    },
    {
      "type": "range",
      "id": "single_image_index",
      "label": "Single Pack Image",
      "info": "Select which product image to display for Single pack (1 = first image)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "all_flavours_image_index",
      "label": "All Flavours Image",
      "info": "Select which product image to display for All Flavours (1 = first image)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    }
  ]
}
