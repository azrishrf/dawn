<!-- Product FAQ Section -->
<div class="faq-section">
  <div class="faq-container">
    <h2 class="faq-heading">
      {{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}
    </h2>
    <div class="faq-list">
      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="faq-trigger"
            data-faq-trigger
          >
            <span class="faq-question">
              {{ block.settings.question }}
            </span>
            <svg
              class="faq-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="faq-content">
            <div class="faq-answer">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .faq-section {
    padding: 64px 0;
    background-color: #fff;
  }

  .faq-container {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .faq-heading {
    font-size: 24px;
    font-weight: bold;
    text-align: center;
    margin-bottom: 48px;
    letter-spacing: 0.1em;
  }

  .faq-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
  }

  .faq-question {
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .faq-trigger:hover .faq-question {
    color: #4b5563;
  }

  .faq-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .faq-trigger.open .faq-icon {
    transform: rotate(180deg);
  }

  .faq-content {
    overflow: hidden;
    transition: all 0.3s ease-in-out;
    max-height: 0;
    opacity: 0;
  }

  .faq-content.open {
    max-height: 1000px;
    opacity: 1;
  }

  .faq-answer {
    font-size: 14px;
    color: #000;
    font-weight: 500;
    margin-bottom: 16px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const faqTriggers = document.querySelectorAll('[data-faq-trigger]');

    faqTriggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        const content = this.nextElementSibling;
        const isOpen = this.classList.contains('open');

        if (isOpen) {
          this.classList.remove('open');
          content.classList.remove('open');
        } else {
          this.classList.add('open');
          content.classList.add('open');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "class": "product-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How do I use this product?",
            "answer": "<p>Mix one scoop with water or milk and shake well.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "When is the best time to take it?",
            "answer": "<p>Best consumed within 30 minutes after your workout.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is it safe for daily use?",
            "answer": "<p>Yes, this product is safe for daily consumption as directed.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
