{% comment %}
  Split Promo Section
  Displays a promotional banner with image/video on one side and content on the other
{% endcomment %}

<div class="flex flex-col lg:flex-row w-full {% if section.settings.reverse_layout %}lg:flex-row-reverse{% endif %}">
  <!-- Content Side -->
  <div
    class="w-full lg:w-1/2 h-[540px] lg:h-auto flex flex-col justify-end items-start p-8 lg:p-16 relative {% if section.settings.dark_theme %}bg-black text-white{% else %}bg-white text-black{% endif %}"
    {% if section.settings.background_image %}
      style="background-image: url({{ section.settings.background_image | img_url: '1200x' }}); background-size: cover; background-position: center;"
    {% endif %}
  >
    <!-- Dark overlay if background image exists -->
    {% if section.settings.background_image %}
      <div class="absolute inset-0 bg-black/30 z-0"></div>
    {% endif %}

    <div class="relative z-10">
      {% if section.settings.subtitle != blank %}
        <h3 class="text-sm lg:text-base font-bold mb-2 tracking-widest uppercase text-white">
          {{ section.settings.subtitle }}
        </h3>
      {% endif %}

      <h2 class="text-2xl lg:text-4xl font-bold mb-4 leading-tight text-white max-w-md">
        {{ section.settings.title }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="text-sm lg:text-base mb-6 leading-relaxed text-white max-w-md font-bold tracking-wide">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <a
        href="{{ section.settings.button_link }}"
        class="inline-block px-8 py-4 font-bold tracking-widest text-sm transition-colors bg-black text-white hover:bg-white hover:text-black"
      >
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>

  <!-- Media Side -->
  <div class="w-full lg:w-1/2 h-[400px] lg:h-[600px] relative overflow-hidden">
    {% if section.settings.video_url != blank %}
      <video
        src="{{ section.settings.video_url }}"
        class="w-full h-full object-cover"
        autoplay
        muted
        loop
        playsinline
        {% if section.settings.image %}
          poster="{{ section.settings.image | img_url: '1200x' }}"
        {% endif %}
      ></video>
    {% elsif section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 1200 }}"
        alt="{{ section.settings.title }}"
        class="w-full h-full object-cover"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
      >
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Split Promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Optional: Add a video URL to replace the image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (Content Side)",
      "info": "Optional: Add a background image for the content side"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "PROMO TITLE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse Layout",
      "default": false,
      "info": "Swap the position of content and media"
    },
    {
      "type": "checkbox",
      "id": "dark_theme",
      "label": "Dark Theme",
      "default": false,
      "info": "Use dark background for content side"
    }
  ],
  "presets": [
    {
      "name": "Split Promo"
    }
  ]
}
{% endschema %}
