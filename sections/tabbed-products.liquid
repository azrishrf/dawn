                        alt="{{ product_4.featured_image.alt | escape }}"
                        width="800"
                        height="1067"
                        class="product-image"
                        loading="lazy"
                      >
                    {% endif %}
                  </a>

                  <!-- Product Info -->
                  <div class="product-info">
                    <h3 class="product-title">
                      {% if block.settings.product_4_custom_name != blank %}
                        {{ block.settings.product_4_custom_name }}
                      {% else %}
                        {{ product_4.title -}}
                        {%- if variant_4.title != 'Default Title' %} - {{ variant_4.title }}{% endif %}
                      {% endif %}
                    </h3>
                    <div class="price-wrapper">
                      <span class="product-price">RM {{ variant_4.price | money_without_currency }}</span>
                      {% if variant_4.compare_at_price > variant_4.price %}
