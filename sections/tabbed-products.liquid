                      {% endif %}
                    </div>
                  </div>

                  <!-- Shop Now Button -->
                  <a href="{{ product_2.url }}?variant={{ variant_2.id }}" class="shop-now-button"> SHOP NOW </a>
                </div>
              {% endif %}

              {% if product_3 != blank %}
                <div class="product-card">
                  <!-- Product Image -->
                  <a href="{{ product_3.url }}?variant={{ variant_3.id }}" class="product-image-wrapper">
                    {% if variant_3.featured_image %}
