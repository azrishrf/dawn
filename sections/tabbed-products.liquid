                  <!-- Shop Now Button -->
                  <a href="{{ product_4.url }}?variant={{ variant_4.id }}" class="shop-now-button"> SHOP NOW </a>
                </div>
              {% endif %}

              {% if product_5 != blank %}
                <div class="product-card">
                  <!-- Product Image -->
                  <a href="{{ product_5.url }}?variant={{ variant_5.id }}" class="product-image-wrapper">
                    {% if variant_5.featured_image %}
