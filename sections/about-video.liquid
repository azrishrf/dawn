{% comment %}
  About Video Section
  Displays factory video with about us content
{% endcomment %}

<style>
  .about-video-section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .about-video-section {
      flex-direction: row;
      max-width: 1280px;
      margin: 0 auto;
      padding: 32px;
    }
  }

  .about-video-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 32px 24px;
    background-color: #ffffff;
    color: #000000;
    position: relative;
  }

  @media (min-width: 1024px) {
    .about-video-content {
      flex: 1;
      height: auto;
      padding: 32px 64px 32px 0;
    }
  }

  .about-video-content-inner {
    position: relative;
    z-index: 10;
  }

  .about-video-subtitle {
    font-size: 14px;
    font-weight: bold;
    margin: 0 0 8px 0;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: #000000;
  }

  @media (min-width: 1024px) {
    .about-video-subtitle {
      font-size: 16px;
    }
  }

  .about-video-title {
    font-size: 24px;
    font-weight: bold;
    margin: 0 0 16px 0;
    line-height: 1.2;
    color: #000000;
    max-width: 448px;
  }

  @media (min-width: 1024px) {
    .about-video-title {
      font-size: 36px;
    }
  }

  .about-video-text-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-video-text {
    font-size: 16px;
    line-height: 1.6;
    color: #000000;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .about-video-text p {
    margin: 0;
  }

  .about-video-media {
    width: 100%;
    aspect-ratio: 9 / 16;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .about-video-media {
      width: auto;
      height: 500px;
      max-height: 500px;
      border-radius: 8px;
    }
  }

  .about-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<div class="about-video-section">
  <!-- Content Side -->
  <div class="about-video-content">
    <div class="about-video-content-inner">
      <h3 class="about-video-subtitle">{{ section.settings.subtitle }}</h3>
      <h2 class="about-video-title">{{ section.settings.title }}</h2>
      <div class="about-video-text-container">
        {% if section.settings.text_1 != blank %}
          <div class="about-video-text">{{ section.settings.text_1 }}</div>
        {% endif %}
        {% if section.settings.text_2 != blank %}
          <div class="about-video-text">{{ section.settings.text_2 }}</div>
        {% endif %}
        {% if section.settings.text_3 != blank %}
          <div class="about-video-text">{{ section.settings.text_3 }}</div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Media Side -->
  <div class="about-video-media">
    {% if section.settings.video != blank %}
      <video
        src="{{ section.settings.video.sources.last.url }}"
        width="{{ section.settings.video.sources.last.width }}"
        height="{{ section.settings.video.sources.last.height }}"
        class="about-video-element"
        autoplay
        muted
        loop
        playsinline
      ></video>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "About Video",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "ABOUT US"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "WHERE THE MAGIC HAPPENS"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "First Paragraph",
      "default": "<p>Step inside our state-of-the-art facility where innovation meets tradition. Every batch is carefully crafted, tested, and perfected to ensure nothing but the best.</p>"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Second Paragraph",
      "default": "<p>Step inside our state-of-the-art facility where innovation meets tradition. Every batch is carefully crafted, tested, and perfected to ensure nothing but the best.</p>"
    },
    {
      "type": "richtext",
      "id": "text_3",
      "label": "Third Paragraph",
      "default": "<p>Step inside our state-of-the-art facility where innovation meets tradition. Every batch is carefully crafted, tested, and perfected to ensure nothing but the best.</p>"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    }
  ],
  "presets": [
    {
      "name": "About Section & Video"
    }
  ]
}
{% endschema %}
