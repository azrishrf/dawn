{% comment %}
  Features Section
  Displays feature icons with titles and descriptions in a grid
{% endcomment %}

<style>
  .features-section {
    background-color: #ffffff;
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .features-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .features-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }
  }

  @media (min-width: 1024px) {
    .features-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 24px 0 24px !important;
  }

  @media (min-width: 1024px) {
    .feature-item {
      flex-direction: row;
      align-items: center;
      text-align: left;
      border-right: 4px solid #000000;
    }

    .feature-item:last-child {
      border-right: none;
    }
  }

  .feature-icon {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .feature-icon {
      margin-bottom: 0;
      margin-right: 24px;
    }
  }

  .feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .feature-content h3 {
    font-weight: bold;
    color: #000000;
    margin: 0 !important;
  }

  .feature-content p {
    font-size: 12px;
    font-weight: 500;
    color: #000000;
    letter-spacing: 0.025em;
  }
</style>

<div class="features-section">
  <div class="features-container">
    {% for block in section.blocks %}
      {% if block.type == 'feature' %}
        <div class="feature-item">
          <div class="feature-icon">
            <img
              src="{{ block.settings.icon | img_url: '200x' }}"
              alt="{{ block.settings.title }}"
              width="80"
              height="80"
              loading="lazy"
            >
          </div>
          <div class="feature-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Features Products - Home",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "PREMIUM INGREDIENTS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "SOURCED GLOBALLY FOR QUALITY."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon",
          "info": "Recommended size: 80x80px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "PREMIUM INGREDIENTS",
            "description": "SOURCED GLOBALLY FOR QUALITY."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "FULL TRANSPARENCY",
            "description": "NO HIDDEN BLENDS. EVER."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "THIRD-PARTY TESTED",
            "description": "QUALITY, CONSISTENCY, TRUST."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "ATHLETE BUILT",
            "description": "FORMULAS MADE BY REAL ATHLETES."
          }
        }
      ]
    }
  ]
}
{% endschema %}
