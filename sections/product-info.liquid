<!-- Product Info Section -->
{% assign current_variant = product.selected_or_first_available_variant %}

<div class="product-info">
  <h1 class="product-title">{{ product.title }}</h1>
  {% if product.metafields.custom.subtitle %}
    <p class="product-subtitle">{{ product.metafields.custom.subtitle }}</p>
  {% endif %}

  <!-- Price -->
  <div class="product-price">
    <span data-product-price>{{ current_variant.price | money }}</span>
  </div>

  <hr class="product-divider">

  <!-- Product Form -->
  {% form 'product', product, id: 'product-form', data-product-form: '' %}
    <!-- Variants -->
    {% if product.variants.size > 1 %}
      <div class="variants-container">
        <label class="variants-label">
          FLAVOR: <span class="variant-name-display" data-variant-name>{{ current_variant.title }}</span>
        </label>
        <div class="variants-grid">
          {% for variant in product.variants %}
            <button
              type="button"
              data-variant-button
              data-variant-id="{{ variant.id }}"
              data-variant-name="{{ variant.title }}"
              data-variant-price="{{ variant.price }}"
              data-variant-available="{{ variant.available }}"
              class="variant-button {% if variant.available %}variant-available{% else %}variant-unavailable{% endif %}"
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              {{ variant.title }}
              {% unless variant.available %}(Sold Out){% endunless %}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- Hidden variant input -->
    <input type="hidden" name="id" data-variant-id-input value="{{ current_variant.id }}">

    <!-- Quantity & Add to Cart -->
    <div class="cart-controls">
      <div class="quantity-selector">
        <button
          type="button"
          data-quantity-minus
          class="quantity-button"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>
        <input
          type="text"
          name="quantity"
          value="1"
          data-quantity-input
          readonly
          class="quantity-input"
        >
        <button
          type="button"
          data-quantity-plus
          class="quantity-button"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>
      </div>
      <button
        type="submit"
        data-add-to-cart
        class="add-to-cart-button"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
      </button>
    </div>
  {% endform %}

  <!-- Description -->
  <div class="product-description">
    {{ product.description }}
  </div>

  <!-- Accordions -->
  <div class="accordions-container">
    {% if section.settings.accordion_1_title != blank %}
      <div class="accordion-item">
        <button
          type="button"
          class="accordion-trigger"
          data-accordion-trigger
        >
          <span class="accordion-title">
            {{ section.settings.accordion_1_title }}
          </span>
          <svg
            class="accordion-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            {{ section.settings.accordion_1_content }}
          </div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.accordion_2_title != blank %}
      <div class="accordion-item">
        <button
          type="button"
          class="accordion-trigger"
          data-accordion-trigger
        >
          <span class="accordion-title">
            {{ section.settings.accordion_2_title }}
          </span>
          <svg
            class="accordion-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            {{ section.settings.accordion_2_content }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .product-info {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .product-info {
      width: 50%;
    }
  }

  .product-title {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 8px;
    letter-spacing: 0.025em;
  }

  @media (min-width: 1024px) {
    .product-title {
      font-size: 24px;
    }
  }

  .product-subtitle {
    color: #4b5563;
    margin-bottom: 16px;
    font-weight: 500;
  }

  .product-price {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 16px;
  }

  .product-divider {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin-bottom: 32px;
  }

  .variants-container {
    margin-bottom: 32px;
  }

  .variants-label {
    display: block;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .variant-name-display {
    color: #6b7280;
    font-weight: normal;
  }

  .variants-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .variant-button {
    padding: 12px 16px;
    font-size: 12px;
    font-weight: bold;
    border: 1px solid;
    background: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .variant-available {
    border-color: #e5e7eb;
    background-color: #fff;
    color: #000;
  }

  .variant-available:hover {
    border-color: #000;
  }

  .variant-button.active {
    border-color: #cf2317;
    background-color: #cf2317;
    color: white;
  }

  .variant-unavailable {
    border-color: #f3f4f6;
    background-color: #f9fafb;
    color: #d1d5db;
    cursor: not-allowed;
  }

  .cart-controls {
    display: flex;
    gap: 16px;
    margin-bottom: 32px;
    height: 48px;
  }

  .quantity-selector {
    display: flex;
    border: 1px solid #d1d5db;
    width: 128px;
    align-items: center;
  }

  .quantity-button {
    width: 40px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .quantity-button:hover {
    background-color: #f3f4f6;
  }

  .quantity-input {
    width: 100%;
    height: 100%;
    text-align: center;
    outline: none;
    font-weight: bold;
    border: none;
  }

  .add-to-cart-button {
    flex: 1;
    background-color: #000;
    color: #fff;
    font-weight: bold;
    letter-spacing: 0.1em;
    font-size: 14px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .add-to-cart-button:hover {
    background-color: #1f2937;
  }

  .add-to-cart-button:disabled {
    background-color: #6b7280;
    cursor: not-allowed;
  }

  .product-description {
    margin-bottom: 32px;
    color: #4b5563;
    font-size: 14px;
    line-height: 1.6;
  }

  .accordions-container {
    border-top: 1px solid #e5e7eb;
  }

  .accordion-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
  }

  .accordion-title {
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .accordion-trigger:hover .accordion-title {
    color: #4b5563;
  }

  .accordion-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .accordion-trigger.open .accordion-icon {
    transform: rotate(180deg);
  }

  .accordion-content {
    overflow: hidden;
    transition: all 0.3s ease-in-out;
    max-height: 0;
    opacity: 0;
  }

  .accordion-content.open {
    max-height: 1000px;
    opacity: 1;
  }

  .accordion-content-inner {
    font-size: 14px;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 16px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('[data-product-form]');
    if (!form) return;

    // Variant Selection
    const variantButtons = document.querySelectorAll('[data-variant-button]');
    const variantInput = document.querySelector('[data-variant-id-input]');
    const variantNameDisplay = document.querySelector('[data-variant-name]');
    const priceDisplay = document.querySelector('[data-product-price]');
    const addToCartButton = document.querySelector('[data-add-to-cart]');

    variantButtons.forEach((button) => {
      button.addEventListener('click', function () {
        if (this.dataset.variantAvailable === 'false') return;

        // Update active state
        variantButtons.forEach((btn) => btn.classList.remove('active'));
        this.classList.add('active');

        // Update form values
        const variantId = this.dataset.variantId;
        const variantName = this.dataset.variantName;
        const variantPrice = this.dataset.variantPrice;
        const isAvailable = this.dataset.variantAvailable === 'true';

        variantInput.value = variantId;
        if (variantNameDisplay) variantNameDisplay.textContent = variantName;
        if (priceDisplay) {
          // Format price (assuming price is in cents)
          const price = parseFloat(variantPrice) / 100;
          priceDisplay.textContent = 'RM ' + price.toFixed(2);
        }

        // Update button state
        if (addToCartButton) {
          if (isAvailable) {
            addToCartButton.disabled = false;
            addToCartButton.textContent = 'ADD TO CART';
          } else {
            addToCartButton.disabled = true;
            addToCartButton.textContent = 'SOLD OUT';
          }
        }

        // Trigger gallery update if needed
        const event = new CustomEvent('variant:changed', { detail: { variantId: variantId } });
        document.dispatchEvent(event);
      });
    });

    // Set initial active variant
    const firstAvailableButton = document.querySelector('[data-variant-button][data-variant-available="true"]');
    if (firstAvailableButton && !document.querySelector('[data-variant-button].active')) {
      firstAvailableButton.classList.add('active');
    }

    // Quantity Controls
    const quantityInput = document.querySelector('[data-quantity-input]');
    const minusButton = document.querySelector('[data-quantity-minus]');
    const plusButton = document.querySelector('[data-quantity-plus]');

    if (minusButton && quantityInput) {
      minusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        if (currentQty > 1) {
          quantityInput.value = currentQty - 1;
        }
      });
    }

    if (plusButton && quantityInput) {
      plusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        quantityInput.value = currentQty + 1;
      });
    }

    // Accordion functionality
    const accordionTriggers = document.querySelectorAll('[data-accordion-trigger]');

    accordionTriggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        const content = this.nextElementSibling;
        const isOpen = this.classList.contains('open');

        if (isOpen) {
          this.classList.remove('open');
          content.classList.remove('open');
        } else {
          this.classList.add('open');
          content.classList.add('open');
        }
      });
    });

    // Form submission
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const formData = new FormData(form);

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
        });

        if (response.ok) {
          const data = await response.json();
          // Trigger cart update event
          const event = new CustomEvent('cart:updated', { detail: data });
          document.dispatchEvent(event);
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product Info",
  "tag": "section",
  "class": "product-info-section",
  "settings": [
    {
      "type": "text",
      "id": "accordion_1_title",
      "label": "Accordion 1 Title",
      "default": "WHY SHOULD YOU USE ISO[H1]"
    },
    {
      "type": "richtext",
      "id": "accordion_1_content",
      "label": "Accordion 1 Content"
    },
    {
      "type": "text",
      "id": "accordion_2_title",
      "label": "Accordion 2 Title",
      "default": "SUPPLEMENT FACTS"
    },
    {
      "type": "richtext",
      "id": "accordion_2_content",
      "label": "Accordion 2 Content"
    }
  ],
  "presets": [
    {
      "name": "Product Info"
    }
  ]
}
{% endschema %}
