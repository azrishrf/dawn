</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Mobile gallery scroll handling
    const scrollContainer = document.querySelector('[data-gallery-scroll]');
    const dots = document.querySelectorAll('[data-dot-index]');

    if (scrollContainer && dots.length > 0) {
      let currentIndex = 0;

      // Update dots on scroll
      scrollContainer.addEventListener('scroll', function () {
        const scrollLeft = scrollContainer.scrollLeft;
        const firstItem = scrollContainer.querySelector('.gallery-image-item');

        if (firstItem) {
          const itemWidth = firstItem.offsetWidth;
          const gap = 4;
          const stride = itemWidth + gap;
          const newIndex = Math.round(scrollLeft / stride);

          if (newIndex !== currentIndex && newIndex >= 0 && newIndex < dots.length) {
            currentIndex = newIndex;
            updateDots(newIndex);
          }
        }
      });

      // Click on dots
      dots.forEach((dot, index) => {
        dot.addEventListener('click', function () {
          const firstItem = scrollContainer.querySelector('.gallery-image-item');
          if (firstItem) {
            const gap = 4;
            const stride = firstItem.offsetWidth + gap;
            scrollContainer.scrollTo({
              left: stride * index,
              behavior: 'smooth',
            });
            currentIndex = index;
            updateDots(index);
          }
        });
      });

      function updateDots(index) {
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      // Initialize first dot as active
      updateDots(0);
    }

    // Desktop thumbnail click handling
    const thumbnails = document.querySelectorAll('[data-thumbnail]');
    const mainImage = document.querySelector('[data-main-image]');

    if (thumbnails.length > 0 && mainImage) {
      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener('click', function () {
          const imageUrl = this.querySelector('img').src.replace('200x', '1200x');
          mainImage.src = imageUrl;

          // Update active thumbnail
          thumbnails.forEach((t) => t.classList.remove('active'));
          this.classList.add('active');
        });
      });

      // Set first thumbnail as active
      if (thumbnails[0]) {
        thumbnails[0].classList.add('active');
      }
    }

    // Product Info JavaScript
    const form = document.querySelector('[data-product-form]');
    if (!form) return;

    // Pack and Flavor Selection
    const packCards = document.querySelectorAll('[data-pack-card]');
    const flavorContainer = document.querySelector('[data-flavor-container]');
    const flavorButtons = document.querySelectorAll('[data-flavor-button]');
    const flavorDisplay = document.querySelector('[data-flavor-display]');
    const variantInput = document.querySelector('[data-variant-id-input]');
    const priceDisplay = document.querySelector('[data-product-price]');
    const addToCartButton = document.querySelector('[data-add-to-cart]');

    let selectedPackType = 'single'; // Default to single pack
    let selectedFlavor = null;

    // Pack card click handling
    packCards.forEach((card) => {
      card.addEventListener('click', function () {
        const packType = this.dataset.packType;
        
        // Update active state
        packCards.forEach((c) => c.classList.remove('active'));
        this.classList.add('active');
        
        selectedPackType = packType;
        selectedFlavor = null; // Reset flavor selection
        
        // Show/hide bumps based on pack type (per-bump targeting)
        const bumpContainer = document.querySelector('[data-bump-container]');
        if (bumpContainer) {
          const allBumpLabels = bumpContainer.querySelectorAll('.order-bump-label');
          let visibleBumpCount = 0;

          allBumpLabels.forEach(label => {
            const bumpPack = label.dataset.bumpPack || 'single';
            const shouldShow = bumpPack === 'all' || bumpPack === packType;
            label.style.display = shouldShow ? 'flex' : 'none';
            if (!shouldShow) {
              // Uncheck hidden bumps
              const cb = label.querySelector('.bump-checkbox');
              if (cb) cb.checked = false;
            } else {
              visibleBumpCount++;
            }
          });

          // Show the container only if at least one bump is visible
          bumpContainer.style.display = visibleBumpCount > 0 ? 'flex' : 'none';
        }

        // Show/hide flavor selection based on pack type
        if (packType === 'single' || packType === 'combo2' || packType === 'combo3') {
          flavorContainer.style.display = 'block';
          
          // Filter and show only relevant flavors
          flavorButtons.forEach((btn) => {
            if (btn.dataset.packType === packType) {
              btn.style.display = 'inline-block';
              btn.classList.remove('active');
            } else {
              btn.style.display = 'none';
            }
          });
          
          // Reset flavor display
          if (flavorDisplay) {
            flavorDisplay.textContent = 'Please select a flavor';
          }
          
          // Update price to show the first available variant of this pack type
          const allVariants = {{ product.variants | json }};
          const firstPackVariant = allVariants.find(v => {
            const title = v.title.toLowerCase();
            if (packType === 'single') {
              return title.includes('single') && v.available;
            } else if (packType === 'combo2') {
              return title.includes('combo set 2') && v.available;
            } else if (packType === 'combo3') {
              return title.includes('combo set 3') && v.available;
            }
            return false;
          });
          
          if (firstPackVariant && priceDisplay) {
            const price = parseFloat(firstPackVariant.price) / 100;
            priceDisplay.textContent = 'RM ' + price.toFixed(2);
            
            // Update compare at price if it exists
            const comparePrice = firstPackVariant.compare_at_price;
            const comparePriceDisplay = document.querySelector('[data-compare-price]');
            if (comparePriceDisplay) {
              if (comparePrice && parseFloat(comparePrice) > parseFloat(firstPackVariant.price)) {
                const compareAmount = parseFloat(comparePrice) / 100;
                comparePriceDisplay.textContent = 'RM ' + compareAmount.toFixed(2);
                comparePriceDisplay.style.display = '';
              } else {
                comparePriceDisplay.style.display = 'none';
              }
            }
          }
          
          // Disable add to cart until flavor is selected
          if (addToCartButton) {
            addToCartButton.disabled = true;
            const btnText = addToCartButton.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'SELECT A FLAVOR';
          }
        }
      });
    });

    // Bump variant dropdown handling
    document.querySelectorAll('[data-bump-variants]').forEach(dropdown => {
      const trigger = dropdown.querySelector('[data-bump-variant-trigger]');
      const list = dropdown.querySelector('[data-bump-variant-list]');
      const label = dropdown.querySelector('[data-bump-variant-label]');
      const parentLabel = dropdown.closest('.order-bump-label');
      const bumpCheckbox = parentLabel ? parentLabel.querySelector('.bump-checkbox') : null;
      const options = list ? list.querySelectorAll('.bump-variant-option') : [];

      if (!trigger || !list) return;

      // Toggle dropdown
      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        e.preventDefault();
        const isOpen = list.classList.contains('open');
        // Close all other open dropdowns
        document.querySelectorAll('.bump-variant-list.open').forEach(l => l.classList.remove('open'));
        if (!isOpen) list.classList.add('open');
      });

      // Select option
      options.forEach(option => {
        option.addEventListener('click', function(e) {
          e.stopPropagation();
          e.preventDefault();
          if (this.classList.contains('sold-out')) return;

          // Update active
          options.forEach(o => o.classList.remove('active'));
          this.classList.add('active');

          // Update trigger label
          if (label) label.textContent = this.dataset.bumpVariantTitle;

          // Update bump checkbox variant
          if (bumpCheckbox) bumpCheckbox.dataset.bumpVariant = this.dataset.bumpVariantId;

          // Update bump image if variant has its own image
          const variantImage = this.dataset.variantImage;
          const bumpImg = parentLabel ? parentLabel.querySelector('[data-bump-image]') : null;
          if (bumpImg && variantImage) {
            bumpImg.src = variantImage;
          }

          // Update pricing
          const pricingEl = parentLabel ? parentLabel.querySelector('[data-bump-pricing]') : null;
          if (pricingEl) {
            const price = parseInt(this.dataset.variantPrice || '0');
            const comparePrice = parseInt(this.dataset.variantComparePrice || '0');
            const discountCents = parseInt(dropdown.dataset.bumpDiscountCents || '0');

            const fmt = (cents) => 'RM ' + (cents / 100).toFixed(2);

            if (discountCents > 0) {
              const discounted = price - discountCents;
              pricingEl.innerHTML = `<span class="bump-price-original">${fmt(price)}</span><span class="bump-price-final">${fmt(discounted)}</span>`;
            } else if (comparePrice > price) {
              pricingEl.innerHTML = `<span class="bump-price-original">${fmt(comparePrice)}</span><span class="bump-price-final">${fmt(price)}</span>`;
            } else {
              pricingEl.innerHTML = `<span class="bump-price-final">${fmt(price)}</span>`;
            }
          }

          // Close dropdown
          list.classList.remove('open');
        });
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function() {
      document.querySelectorAll('.bump-variant-list.open').forEach(l => l.classList.remove('open'));
    });

    // Flavor button click handling
    flavorButtons.forEach((button) => {
      button.addEventListener('click', function () {
        if (this.dataset.variantAvailable === 'false') return;
        if (this.dataset.packType !== selectedPackType) return;
        
        // Update active state for flavors
        flavorButtons.forEach((btn) => {
          if (btn.dataset.packType === selectedPackType) {
            btn.classList.remove('active');
          }
        });
        this.classList.add('active');
        
        selectedFlavor = this.dataset.flavorName;
        
        // Update flavor display
        if (flavorDisplay) {
          flavorDisplay.textContent = selectedFlavor;
        }
        
        // Update variant
        updateVariant(this);
      });
    });

    // Function to update variant information
    function updateVariant(button) {
      const variantId = button.dataset.variantId;
      const variantName = button.dataset.variantName;
      const variantPrice = button.dataset.variantPrice;
      const isAvailable = button.dataset.variantAvailable === 'true';

      variantInput.value = variantId;
      
      if (priceDisplay) {
        const price = parseFloat(variantPrice) / 100;
        priceDisplay.textContent = 'RM ' + price.toFixed(2);
      }
      
      // Update compare at price if it exists
      const comparePrice = button.dataset.variantComparePrice;
      const comparePriceDisplay = document.querySelector('[data-compare-price]');
      if (comparePriceDisplay) {
        if (comparePrice && parseFloat(comparePrice) > parseFloat(variantPrice)) {
          const compareAmount = parseFloat(comparePrice) / 100;
          comparePriceDisplay.textContent = 'RM ' + compareAmount.toFixed(2);
          comparePriceDisplay.style.display = '';
        } else {
          comparePriceDisplay.style.display = 'none';
        }
      }

      // Update button state
      // Update button state
      if (addToCartButton) {
        const btnText = addToCartButton.querySelector('.btn-text');
        if (isAvailable) {
          addToCartButton.disabled = false;
          if (btnText) btnText.textContent = 'ADD TO CART';
        } else {
          addToCartButton.disabled = true;
          if (btnText) btnText.textContent = 'SOLD OUT';
        }
      }

      // Update images if variant has a featured image
      const variantImage = button.dataset.variantImage;
      if (variantImage) {
        // Update desktop main image
        const mainImage = document.querySelector('[data-main-image]');
        if (mainImage) {
          mainImage.src = variantImage;
        }

        // Update mobile gallery - find and scroll to matching image
        const scrollContainer = document.querySelector('[data-gallery-scroll]');
        if (scrollContainer) {
          const galleryImages = scrollContainer.querySelectorAll('.gallery-image');
          let matchingIndex = 0;
          
          galleryImages.forEach((img, index) => {
            const imgSrc = img.src.split('?')[0].replace(/(_\d+x\d*\.)/g, '.');
            const variantSrc = variantImage.split('?')[0].replace(/(_\d+x\d*\.)/g, '.');
            
            if (imgSrc.includes(variantSrc.split('/').pop().split('_')[0])) {
              matchingIndex = index;
            }
          });
          
          const firstItem = scrollContainer.querySelector('.gallery-image-item');
          if (firstItem) {
            const gap = 4;
            const stride = firstItem.offsetWidth + gap;
            scrollContainer.scrollTo({
              left: stride * matchingIndex,
              behavior: 'smooth'
            });
            
            const dots = document.querySelectorAll('[data-dot-index]');
            dots.forEach((dot, i) => {
              if (i === matchingIndex) {
                dot.classList.add('active');
              } else {
                dot.classList.remove('active');
              }
            });
          }
        }
        
        // Update desktop thumbnails
        const thumbnails = document.querySelectorAll('[data-thumbnail]');
        if (thumbnails.length > 0) {
          thumbnails.forEach((thumb, index) => {
            const thumbImg = thumb.querySelector('img');
            const thumbSrc = thumbImg.src.split('?')[0].replace(/(_\d+x\d*\.)/g, '.');
            const variantSrc = variantImage.split('?')[0].replace(/(_\d+x\d*\.)/g, '.');
            
            if (thumbSrc.includes(variantSrc.split('/').pop().split('_')[0])) {
              thumbnails.forEach(t => t.classList.remove('active'));
              thumb.classList.add('active');
            }
          });
        }
      }

      // Trigger gallery update if needed
      const event = new CustomEvent('variant:changed', { detail: { variantId: variantId } });
      document.dispatchEvent(event);
    }

    // Check if variant ID is in URL and auto-select
    const urlParams = new URLSearchParams(window.location.search);
    const urlVariantId = urlParams.get('variant');
    let variantAutoSelected = false;
    
    if (urlVariantId) {
      // Find the flavor button with this variant ID
      flavorButtons.forEach((btn) => {
        if (btn.dataset.variantId === urlVariantId) {
          const packType = btn.dataset.packType;
          
          // Select the corresponding pack card
          packCards.forEach((c) => c.classList.remove('active'));
          const packCard = document.querySelector(`[data-pack-card][data-pack-type="${packType}"]`);
          if (packCard) {
            packCard.classList.add('active');
          }
          
          selectedPackType = packType;
          
          const bumpContainer = document.querySelector('[data-bump-container]');
          if (bumpContainer && packType !== 'single') {
            bumpContainer.style.display = 'none';
          }
          
          // Show/hide flavor selection based on pack type
          if (packType === 'single' || packType === 'combo2' || packType === 'combo3') {
            flavorContainer.style.display = 'block';
            
            // Filter and show only relevant flavors
            flavorButtons.forEach((flavorBtn) => {
              if (flavorBtn.dataset.packType === packType) {
                flavorBtn.style.display = 'inline-block';
                flavorBtn.classList.remove('active');
              } else {
                flavorBtn.style.display = 'none';
              }
            });
            
            // Select this flavor button
            btn.classList.add('active');
            selectedFlavor = btn.dataset.flavorName;
            
            if (flavorDisplay) {
              flavorDisplay.textContent = selectedFlavor;
            }
            
            // Update variant
            updateVariant(btn);
            variantAutoSelected = true;
          }
        }
      });
    }
    
    // Initialize: Select single pack by default if no variant was auto-selected
    if (!variantAutoSelected) {
      const singlePackCard = document.querySelector('[data-pack-card][data-pack-type="single"]');
      const combo2PackCard = document.querySelector('[data-pack-card][data-pack-type="combo2"]');
      if (combo2PackCard) {
        combo2PackCard.classList.add('active');
        selectedPackType = 'combo2';

        // Show flavor container
        if (flavorContainer) {
          flavorContainer.style.display = 'block';
        }

        // Show only combo2 pack flavors
        flavorButtons.forEach((btn) => {
          if (btn.dataset.packType === 'combo2') {
            btn.style.display = 'inline-block';
          } else {
            btn.style.display = 'none';
          }
        });

        // Try to auto-select "Chocolate Indulgence"
        const chocIndulgenceBtn = Array.from(flavorButtons).find(btn =>
          btn.dataset.packType === 'combo2' && btn.dataset.flavorName.toLowerCase() === 'chocolate indulgence'
        );

        if (chocIndulgenceBtn && chocIndulgenceBtn.dataset.variantAvailable === 'true') {
          chocIndulgenceBtn.classList.add('active');
          selectedFlavor = chocIndulgenceBtn.dataset.flavorName;
          if (flavorDisplay) {
            flavorDisplay.textContent = selectedFlavor;
          }
          updateVariant(chocIndulgenceBtn);
        } else {
          // Fallback: disable add to cart until a flavor is manually selected
          if (addToCartButton) {
            addToCartButton.disabled = true;
            const btnText = addToCartButton.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'SELECT A FLAVOR';
          }
        }
      }
    }

    // Run bump filter on init for the default selected pack
    const bumpContainer = document.querySelector('[data-bump-container]');
    if (bumpContainer) {
      const allBumpLabels = bumpContainer.querySelectorAll('.order-bump-label');
      let visibleBumpCount = 0;
      allBumpLabels.forEach(label => {
        const bumpPack = label.dataset.bumpPack || 'single';
        const shouldShow = bumpPack === 'all' || bumpPack === selectedPackType;
        label.style.display = shouldShow ? 'flex' : 'none';
        if (shouldShow) visibleBumpCount++;
      });
      bumpContainer.style.display = visibleBumpCount > 0 ? 'flex' : 'none';
    }

    // Quantity Controls
    const quantityInput = document.querySelector('[data-quantity-input]');
    const minusButton = document.querySelector('[data-quantity-minus]');
    const plusButton = document.querySelector('[data-quantity-plus]');

    if (minusButton && quantityInput) {
      minusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        if (currentQty > 1) {
          quantityInput.value = currentQty - 1;
        }
      });
    }

    if (plusButton && quantityInput) {
      plusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        quantityInput.value = currentQty + 1;
      });
    }

    // Accordion functionality
    const accordionTriggers = document.querySelectorAll('[data-accordion-trigger]');

    accordionTriggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        const content = this.nextElementSibling;
        const isOpen = this.classList.contains('open');

        if (isOpen) {
          this.classList.remove('open');
          content.classList.remove('open');
        } else {
          this.classList.add('open');
          content.classList.add('open');
        }
      });
    });

    // Form submission
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const submitButton = form.querySelector('[data-add-to-cart]');
      const btnText = submitButton.querySelector('.btn-text');
      const spinner = submitButton.querySelector('.loading-spinner');

      // Show loading state
      if (submitButton) {
        submitButton.disabled = true;
        if (btnText) btnText.style.opacity = '0'; // Hide text but keep width
        if (spinner) spinner.style.display = 'block';
      }

      const variantInput = form.querySelector('[name="id"]');
      const quantityInput = form.querySelector('[name="quantity"]');
      const bumpCheckboxes = document.querySelectorAll('.bump-checkbox');
      
      let itemsToAdd = [
        {
          id: variantInput.value,
          quantity: parseInt(quantityInput.value) || 1
        }
      ];

      // If they selected the order bump, push it into the array!
      if (bumpCheckboxes) {
        bumpCheckboxes.forEach(cb => {
          if (cb.checked) {
            itemsToAdd.push({
              id: cb.dataset.bumpVariant,
              quantity: 1
            });
          }
        });
      }

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ items: itemsToAdd }),
        });

        if (response.ok) {
          const data = await response.json();
          // Trigger cart update event
          const event = new CustomEvent('cart:updated', { detail: data });
          document.dispatchEvent(event);

          // Open cart drawer and update it
          openCartDrawer();
          updateCartDrawer();
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
        {% comment %} alert('Error adding product to cart. Please try again.'); {% endcomment %}
      } finally {
        // Reset loading state
        if (submitButton) {
          submitButton.disabled = false;
          if (btnText) btnText.style.opacity = '1';
          if (spinner) spinner.style.display = 'none';
        }
      }
    });
  });
</script>

