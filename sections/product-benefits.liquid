{% comment %}
  Product Benefits Section - Slider
  Displays benefit icons with titles and descriptions in a horizontal slider
{% endcomment %}

<style>
  .benefits-section {
    background-color: #000000;
    padding-top: 32px;
    padding-bottom: 32px;
    position: relative;
  }

    @media (min-width: 768px) {
  .benefits-section {
    padding-top: 36px;
    padding-bottom: 36px;
  }


    }

  .benefits-slider-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    padding: 0 16px;
  }

  .benefits-slider-container {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    display: flex;
    gap: 0;
  }

  .benefits-slider-container::-webkit-scrollbar {
    display: none;
  }

  .benefit-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    {% comment %} padding: 0 24px; {% endcomment %}
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .benefits-slider-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
      justify-items: center;
    }

    .benefit-clone-start,
    .benefit-clone-end {
      display: none !important;
    }

    .benefit-item {
      flex: 0 0 50%;
      scroll-snap-align: none;
    }
  }

  @media (min-width: 1024px) {
    .benefits-slider-container {
      grid-template-columns: repeat(4, 1fr);
    }

    .benefit-item {
      flex-direction: row;
      text-align: left;
    }
  }

  .benefit-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 16px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .benefit-icon {
      margin-bottom: 0;
      margin-right: 20px;
    }
  }

  .benefit-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .benefit-icon svg {
    color: #ffffff;
  }

  .benefit-content .benefit-title {
    font-weight: bold;
    font-size: 18px; /* Kept from benefits */
    color: #ffffff;
    margin: 0 !important;
  }

  .benefit-content .benefit-description {
    font-size: 14px; /* Kept from benefits */
    font-weight: 500;
    color: #d1d5db;
    letter-spacing: 0.025em;
    margin: 0;
  }

  /* Dot Indicators */
  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #d1d5db; /* Greyish */
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .slider-dot.active {
    background-color: #ffffff; /* White active */
    width: 24px;
    border-radius: 4px;
  }

  .slider-dot:hover {
    background-color: #9ca3af;
  }

  @media (min-width: 768px) {
    .slider-dots {
      display: none;
    }
  }
</style>

<div class="benefits-section">
  <div class="benefits-slider-wrapper">
    <div class="benefits-slider-container" id="benefits-slider-{{ section.id }}">
      {%- comment -%} Clone slides at the end for infinite loop (will be moved to start via JS) {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="benefit-item benefit-clone-end" data-index="{{ forloop.index0 }}">
            <div class="benefit-icon">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt="{{ block.settings.title }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {% else %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {% endif %}
            </div>
            <div class="benefit-content">
              <p class="benefit-title">{{ block.settings.title }}</p>
              <p class="benefit-description">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {%- comment -%} Original slides {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="benefit-item benefit-original" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="benefit-icon">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt="{{ block.settings.title }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {% else %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {% endif %}
            </div>
            <div class="benefit-content">
              <p class="benefit-title">{{ block.settings.title }}</p>
              <p class="benefit-description">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {%- comment -%} Clone slides at the start for infinite loop {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="benefit-item benefit-clone-start" data-index="{{ forloop.index0 }}">
            <div class="benefit-icon">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt="{{ block.settings.title }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {% else %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {% endif %}
            </div>
            <div class="benefit-content">
              <p class="benefit-title">{{ block.settings.title }}</p>
              <p class="benefit-description">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="slider-dots" id="benefits-dots-{{ section.id }}"></div>
</div>

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const slider = document.getElementById('benefits-slider-' + sectionId);
    const dotsContainer = document.getElementById('benefits-dots-' + sectionId);

    if (!slider || !dotsContainer) return;

    const originalItems = slider.querySelectorAll('.benefit-original');
    const totalOriginalItems = originalItems.length;
    const allItems = slider.querySelectorAll('.benefit-item');
    const totalAllItems = allItems.length;

    let currentIndex = 0;
    let itemsPerView = 1;
    let isTransitioning = false;

    // Calculate items per view based on screen size
    function getItemsPerView() {
      const width = window.innerWidth;
      if (width >= 1024) return 4; // synced with CSS
      if (width >= 768) return 2; // synced with CSS
      return 1;
    }

    // Initialize slider position to start at original items (middle set)
    function initializePosition() {
      itemsPerView = getItemsPerView();
      // Start at the first original item (after the first set of clones)
      currentIndex = totalOriginalItems;
      const itemWidth = slider.scrollWidth / totalAllItems;
      slider.scrollTo({
        left: itemWidth * currentIndex,
        behavior: 'auto',
      });
    }

    // Create dots (only for original items)
    function createDots() {
      dotsContainer.innerHTML = '';
      itemsPerView = getItemsPerView();

      // For infinite scroll, we only show dots for the original items count
      const totalDots = totalOriginalItems;

      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.classList.add('slider-dot');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        if (i === 0) dot.classList.add('active');
        dot.addEventListener('click', () => goToSlide(i));
        dotsContainer.appendChild(dot);
      }
    }

    // Update dots based on current position
    function updateDots() {
      const dots = dotsContainer.querySelectorAll('.slider-dot');
      // Map current index to original items index (0 to totalOriginalItems-1)
      let originalIndex = currentIndex - totalOriginalItems;
      if (originalIndex < 0) originalIndex += totalOriginalItems;
      if (originalIndex >= totalOriginalItems) originalIndex -= totalOriginalItems;

      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === originalIndex);
      });
    }

    // Go to specific slide (slideIndex is the item index relative to original set)
    function goToSlide(slideIndex) {
      const targetIndex = totalOriginalItems + slideIndex;
      currentIndex = targetIndex;
      const itemWidth = slider.scrollWidth / totalAllItems;
      slider.scrollTo({
        left: itemWidth * currentIndex,
        behavior: 'smooth',
      });
      updateDots();
    }

    // Handle infinite loop logic
    function handleInfiniteLoop() {
      if (isTransitioning) return;

      const itemWidth = slider.scrollWidth / totalAllItems;
      const scrollLeft = slider.scrollLeft;
      const newIndex = Math.round(scrollLeft / itemWidth);

      // If we're at the start clones (first set), jump to end of original items
      if (newIndex < totalOriginalItems / 2) {
        isTransitioning = true;
        currentIndex = newIndex + totalOriginalItems;
        slider.scrollTo({
          left: itemWidth * currentIndex,
          behavior: 'auto',
        });
        setTimeout(() => {
          isTransitioning = false;
        }, 50);
      }
      // If we're at the end clones (last set), jump to start of original items
      else if (newIndex >= totalOriginalItems * 2 + totalOriginalItems / 2) {
        isTransitioning = true;
        currentIndex = newIndex - totalOriginalItems;
        slider.scrollTo({
          left: itemWidth * currentIndex,
          behavior: 'auto',
        });
        setTimeout(() => {
          isTransitioning = false;
        }, 50);
      } else {
        currentIndex = newIndex;
      }

      updateDots();
    }

    // Handle scroll event
    let scrollTimeout;
    slider.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        handleInfiniteLoop();
      }, 150);
      handleUserInteraction(); // Pause auto-slide on manual scroll
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      handleUserInteraction();
    });

    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    });

    function handleSwipe() {
      const swipeThreshold = 50;
      const itemWidth = slider.scrollWidth / totalAllItems;

      if (touchStartX - touchEndX > swipeThreshold) {
        // Swipe left - go to next
        currentIndex = Math.min(totalAllItems - itemsPerView, currentIndex + itemsPerView);
        slider.scrollTo({
          left: itemWidth * currentIndex,
          behavior: 'smooth',
        });
      } else if (touchEndX - touchStartX > swipeThreshold) {
        // Swipe right - go to previous
        currentIndex = Math.max(0, currentIndex - itemsPerView);
        slider.scrollTo({
          left: itemWidth * currentIndex,
          behavior: 'smooth',
        });
      }
    }

    // Auto-slide variables
    let autoSlideInterval = null;
    let userInteractionTimeout = null;

    // Go to next slide
    function goToNext() {
      // Logic for infinite scroll next; simply increment index
      const itemWidth = slider.scrollWidth / totalAllItems;
      currentIndex++;
      slider.scrollTo({
        left: itemWidth * currentIndex,
        behavior: 'smooth',
      });
      updateDots();
    }

    // Start auto-slide
    function startAutoSlide() {
      stopAutoSlide();
      // Only auto-slide on mobile
      if (window.innerWidth >= 768) return;

      autoSlideInterval = setInterval(() => {
        goToNext();
      }, 1000);
    }

    // Stop auto-slide
    function stopAutoSlide() {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = null;
      }
    }

    // Handle user interaction
    function handleUserInteraction() {
      stopAutoSlide();

      // Only resume if mobile
      if (window.innerWidth >= 768) return;

      if (userInteractionTimeout) {
        clearTimeout(userInteractionTimeout);
      }

      userInteractionTimeout = setTimeout(() => {
        startAutoSlide();
      }, 1000);
    }

    // Initialize
    createDots();
    initializePosition();
    updateDots();
    if (window.innerWidth < 768) {
      startAutoSlide();
    }

    // Reinitialize on window resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        createDots();
        initializePosition();
        updateDots();

        if (window.innerWidth < 768) {
          startAutoSlide();
        } else {
          stopAutoSlide();
        }
      }, 250);
    });

    // Pause auto-slide when page is not visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoSlide();
      } else {
        if (window.innerWidth < 768) {
          startAutoSlide();
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Benefits",
  "tag": "section",
  "class": "product-benefits-section",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image",
          "info": "Recommended size: 48x48px. Leave empty to use default checkmark icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Benefit description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "High Quality",
            "description": "Premium ingredients for best results"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Fast Absorption",
            "description": "Quickly absorbed by your body"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Great Taste",
            "description": "Delicious flavors you'll love"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Trusted Brand",
            "description": "Used by thousands of satisfied customers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
