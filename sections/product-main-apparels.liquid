<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Mobile gallery scroll handling
    const scrollContainer = document.querySelector('[data-gallery-scroll]');
    const dots = document.querySelectorAll('[data-dot-index]');

    if (scrollContainer && dots.length > 0) {
      let currentIndex = 0;

      // Update dots on scroll
      scrollContainer.addEventListener('scroll', function () {
        const scrollLeft = scrollContainer.scrollLeft;
        const firstItem = scrollContainer.querySelector('.gallery-image-item');

        if (firstItem) {
          const itemWidth = firstItem.offsetWidth;
          const gap = 4;
          const stride = itemWidth + gap;
          const newIndex = Math.round(scrollLeft / stride);

          if (newIndex !== currentIndex && newIndex >= 0 && newIndex < dots.length) {
            currentIndex = newIndex;
            updateDots(newIndex);
          }
        }
      });

      // Click on dots
      dots.forEach((dot, index) => {
        dot.addEventListener('click', function () {
          const firstItem = scrollContainer.querySelector('.gallery-image-item');
          if (firstItem) {
            const itemWidth = firstItem.offsetWidth;
            const gap = 4;
            const stride = itemWidth + gap;
            const scrollLeft = index * stride;
            scrollContainer.scrollTo({ left: scrollLeft, behavior: 'smooth' });
            currentIndex = index;
            updateDots(index);
          }
        });
      });

      function updateDots(index) {
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      // Initialize first dot as active
      updateDots(0);
    }

    // Desktop thumbnail click handling
    const thumbnails = document.querySelectorAll('[data-thumbnail]');
    const mainImage = document.querySelector('[data-main-image]');

    if (thumbnails.length > 0 && mainImage) {
      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener('click', function () {
          const imageUrl = this.querySelector('img').src.replace('200x', '1200x');
          mainImage.src = imageUrl;

          // Update active thumbnail
          thumbnails.forEach((t) => t.classList.remove('active'));
          this.classList.add('active');
        });
      });

      // Set first thumbnail as active
      if (thumbnails[0]) {
        thumbnails[0].classList.add('active');
      }
    }

    // Product Info JavaScript
    const form = document.querySelector('[data-product-form]');
    if (!form) return;

    // Apparel and Size Selection
    const apparelCards = document.querySelectorAll('[data-apparel-card]');
    const sizeContainer = document.querySelector('[data-size-container]');
    const sizeButtons = document.querySelectorAll('[data-size-button]');
    const sizeDisplay = document.querySelector('[data-size-display]');
    const variantInput = document.querySelector('[data-variant-id-input]');
    const priceDisplay = document.querySelector('[data-product-price]');
    const addToCartButton = document.querySelector('[data-add-to-cart]');

    let selectedApparelType = null;
    let selectedSize = null;

    // Apparel card click handling
    apparelCards.forEach((card) => {
      card.addEventListener('click', function () {
        const apparelType = this.dataset.apparelType;

        // Update active state
        apparelCards.forEach((c) => c.classList.remove('active'));
        this.classList.add('active');

        selectedApparelType = apparelType;
        selectedSize = null; // Reset size selection

        // Show size selection
        sizeContainer.style.display = 'block';

        // Show only sizes for this apparel type
        sizeButtons.forEach((btn) => {
          if (btn.dataset.apparelType === apparelType) {
            btn.style.display = '';
          } else {
            btn.style.display = 'none';
          }
          btn.classList.remove('active');
        });

        // Reset size display
        if (sizeDisplay) {
          sizeDisplay.textContent = 'Select a size';
        }

        // Update button state
        if (addToCartButton) {
          addToCartButton.disabled = true;
          addToCartButton.textContent = 'SELECT SIZE';
        }
      });
    });

    // Size button click handling
    sizeButtons.forEach((button) => {
      button.addEventListener('click', function () {
        if (this.dataset.variantAvailable === 'false') return;
        if (this.dataset.apparelType !== selectedApparelType) return;

        // Update active state for sizes
        sizeButtons.forEach((btn) => {
          if (btn.dataset.apparelType === selectedApparelType) {
            btn.classList.remove('active');
          }
        });
        this.classList.add('active');

        selectedSize = this.dataset.sizeName;

        // Update size display
        if (sizeDisplay) {
          sizeDisplay.textContent = selectedSize;
        }

        // Update variant
        updateVariant(this);
      });
    });

    // Function to update variant information
    function updateVariant(button) {
      const variantId = button.dataset.variantId;
      const variantName = button.dataset.variantName;
      const variantPrice = button.dataset.variantPrice;
      const isAvailable = button.dataset.variantAvailable === 'true';

      variantInput.value = variantId;

      if (priceDisplay) {
        const price = parseFloat(variantPrice) / 100;
        priceDisplay.textContent = 'RM ' + price.toFixed(2);
      }

      // Update compare at price if it exists
      const comparePrice = button.dataset.variantComparePrice;
      const comparePriceDisplay = document.querySelector('[data-compare-price]');
      if (comparePriceDisplay) {
        if (comparePrice && parseFloat(comparePrice) > parseFloat(variantPrice)) {
          const comparePriceValue = parseFloat(comparePrice) / 100;
          comparePriceDisplay.textContent = 'RM ' + comparePriceValue.toFixed(2);
          comparePriceDisplay.style.display = '';
        } else {
          comparePriceDisplay.style.display = 'none';
        }
      }

      // Update button state
      if (addToCartButton) {
        if (isAvailable) {
          addToCartButton.disabled = false;
          addToCartButton.textContent = 'ADD TO CART';
        } else {
          addToCartButton.disabled = true;
          addToCartButton.textContent = 'OUT OF STOCK';
        }
      }

      // Update images if variant has a featured image
      const variantImage = button.dataset.variantImage;
      if (variantImage) {
        // Update desktop main image
        const mainImage = document.querySelector('[data-main-image]');
        if (mainImage) {
          mainImage.src = variantImage;
        }

        // Update mobile gallery - find and scroll to matching image
        const scrollContainer = document.querySelector('[data-gallery-scroll]');
        if (scrollContainer) {
          const galleryImages = scrollContainer.querySelectorAll('.gallery-image');
          let matchIndex = -1;

          galleryImages.forEach((img, index) => {
            const imgSrc = img.src.replace(/_(200x|400x|800x|1200x)/, '');
            const variantImgSrc = variantImage.replace(/_(200x|400x|800x|1200x)/, '');

            if (imgSrc === variantImgSrc) {
              matchIndex = index;
            }
          });

          if (matchIndex !== -1) {
            const firstItem = scrollContainer.querySelector('.gallery-image-item');
            if (firstItem) {
              const itemWidth = firstItem.offsetWidth;
              const gap = 4;
              const stride = itemWidth + gap;
              const scrollLeft = matchIndex * stride;
              scrollContainer.scrollTo({ left: scrollLeft, behavior: 'smooth' });

              // Update dots
              const dots = document.querySelectorAll('[data-dot-index]');
              dots.forEach((dot, i) => {
                if (i === matchIndex) {
                  dot.classList.add('active');
                } else {
                  dot.classList.remove('active');
                }
              });
            }
          }
        }

        // Update desktop thumbnails
        const thumbnails = document.querySelectorAll('[data-thumbnail]');
        if (thumbnails.length > 0) {
          thumbnails.forEach((thumb, index) => {
            const thumbImg = thumb.querySelector('img');
            const thumbSrc = thumbImg.src.replace(/_(200x|400x|800x|1200x)/, '');
            const variantImgSrc = variantImage.replace(/_(200x|400x|800x|1200x)/, '');

            if (thumbSrc === variantImgSrc) {
              thumbnails.forEach((t) => t.classList.remove('active'));
              thumb.classList.add('active');
            }
          });
        }
      }

      // Trigger gallery update if needed
      const event = new CustomEvent('variant:changed', { detail: { variantId: variantId } });
      document.dispatchEvent(event);
    }

    // Check if variant ID is in URL and auto-select
    const urlParams = new URLSearchParams(window.location.search);
    const urlVariantId = urlParams.get('variant');

    if (urlVariantId) {
      // Find the size button with this variant ID
      sizeButtons.forEach((btn) => {
        if (btn.dataset.variantId === urlVariantId) {
          const apparelType = btn.dataset.apparelType;

          // Find and click the apparel card
          apparelCards.forEach((card) => {
            if (card.dataset.apparelType === apparelType) {
              card.click();

              // Then click the size button
              setTimeout(() => {
                btn.click();
              }, 100);
            }
          });
        }
      });
    } else {
      // Auto-select first apparel type if no URL variant
      if (apparelCards.length > 0) {
        apparelCards[0].click();
      }
    }

    // Quantity Controls
    const quantityInput = document.querySelector('[data-quantity-input]');
    const minusButton = document.querySelector('[data-quantity-minus]');
    const plusButton = document.querySelector('[data-quantity-plus]');

    if (minusButton && quantityInput) {
      minusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        if (currentQty > 1) {
          quantityInput.value = currentQty - 1;
        }
      });
    }

    if (plusButton && quantityInput) {
      plusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        quantityInput.value = currentQty + 1;
      });
    }

    // Form submission
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const formData = new FormData(form);

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
        });

        if (response.ok) {
          await updateCartDrawer();
          openCartDrawer();
        } else {
          const errorData = await response.json();
          console.error('Error adding to cart:', errorData);
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
      }
    });
  });

  // Cart Drawer Functions
  function openCartDrawer() {
    document.getElementById('cartDrawer').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeCartDrawer() {
    document.getElementById('cartDrawer').classList.remove('active');
    document.body.style.overflow = '';
  }

  async function updateCartDrawer() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();

      const itemsContainer = document.getElementById('cartDrawerItems');
      const totalElement = document.getElementById('cartDrawerTotal');

      if (cart.items.length === 0) {
        itemsContainer.innerHTML = '<div class="cart-drawer-empty">Your cart is empty</div>';
      } else {
        itemsContainer.innerHTML = cart.items
          .map(
            (item) => `
          <div class="cart-drawer-item">
            <img src="${item.featured_image.url}" alt="${item.title}" class="cart-item-image">
            <div class="cart-item-details">
              <div class="cart-item-title">${item.product_title}</div>
              <div class="cart-item-variant">${item.variant_title}</div>
              <div class="cart-item-quantity">Qty: ${item.quantity}</div>
              <div class="cart-item-price">RM ${(item.final_line_price / 100).toFixed(2)}</div>
            </div>
          </div>
        `
          )
          .join('');
      }

      totalElement.textContent = `RM ${(cart.total_price / 100).toFixed(2)}`;

      // Update header cart count
      const cartCountElement = document.getElementById('cartCount');
      if (cartCountElement) {
        cartCountElement.textContent = cart.item_count;
      }
    } catch (error) {
      console.error('Error updating cart drawer:', error);
    }
  }
</script>

