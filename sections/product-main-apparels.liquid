<!-- Product Main Section for Apparels (Gallery + Info) -->
{% assign current_variant = product.selected_or_first_available_variant %}

<div class="product-main-section">
  <div class="product-main-container">
    <div class="product-main-content">
      <!-- Product Gallery -->
      <div class="product-gallery">
        <div class="gallery-sticky-container">
          <!-- Mobile/Tablet View - Swipeable -->
          <div class="gallery-mobile">
            <div class="gallery-mobile-wrapper">
              <div class="gallery-scroll" data-gallery-scroll>
                <div class="gallery-images-wrapper">
                  {% for image in product.images %}
                    <div class="gallery-image-item">
                      <img
                        src="{{ image | img_url: '400x' }}"
                        alt="{{ image.alt | escape }}"
                        class="gallery-image"
                        width="400"
                        height="533.5"
                        loading="lazy"
                      >
                    </div>
                  {% endfor %}
                </div>
              </div>
              <div class="gallery-dots">
                {% for image in product.images %}
                  <button
                    class="gallery-dot"
                    data-dot-index="{{ forloop.index0 }}"
                    aria-label="Go to image {{ forloop.index }}"
                  ></button>
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- Desktop View - Thumbnails on Left -->
          <div class="gallery-desktop">
            <div class="gallery-thumbnails">
              {% for image in product.images %}
                <button class="gallery-thumbnail" data-thumbnail="{{ forloop.index0 }}">
                  <img
                    src="{{ image | img_url: '200x' }}"
                    alt="{{ image.alt | escape }}"
                    class="thumbnail-image"
                    width="200"
                    height="267"
                    loading="lazy"
                  >
                </button>
              {% endfor %}
            </div>
            <div class="gallery-main-image-container">
              <img
                src="{{ product.featured_image | img_url: '1200x' }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="gallery-main-image"
                width="1200"
                height="1500"
                data-main-image
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <h1 class="product-title">{{ product.title }}</h1>
        {% if product.metafields.custom.subtitle %}
          <p class="product-subtitle">{{ product.metafields.custom.subtitle }}</p>
        {% endif %}

        <!-- Price -->
        <div class="product-price">
          <span data-product-price>RM {{ current_variant.price | money_without_currency }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="price-compare" data-compare-price
              >RM {{ current_variant.compare_at_price | money_without_currency -}}
            </span>
          {% endif %}
        </div>

        <!-- Product Form -->
        {% form 'product', product, id: 'product-form', data-product-form: '' %}
          <!-- Apparel Type Selection -->
          <div class="apparel-selection-container">
            <div class="apparel-options-grid">
              {% assign apparel_types = product.options_with_values[0].values %}
              {% for apparel_type in apparel_types %}
                {% assign apparel_variants = product.variants | where: 'option1', apparel_type %}
                {% assign first_variant = apparel_variants.first %}

                <div
                  class="apparel-option-card"
                  data-apparel-card
                  data-apparel-type="{{ apparel_type | handle }}"
                >
                  <div class="apparel-image-wrapper">
                    {% if first_variant.featured_image %}
                      <img
                        src="{{ first_variant.featured_image | img_url: '400x' }}"
                        alt="{{ apparel_type }}"
                        class="apparel-image"
                        width="400"
                        height="533.5"
                      >
                    {% else %}
                      <img
                        src="{{ product.featured_image | img_url: '400x' }}"
                        alt="{{ apparel_type }}"
                        class="apparel-image"
                        width="400"
                        height="533.5"
                      >
                    {% endif %}
                  </div>

                  <div class="apparel-label">{{ apparel_type }}</div>
                </div>
              {% endfor %}
            </div>

            <!-- Size Selection -->
            <div class="size-selection-container" data-size-container>
              <label class="size-label">
                SIZE: <span class="size-name-display" data-size-display>Select a size</span>
              </label>

              <div class="size-grid">
                {% for variant in product.variants %}
                  {% assign apparel_name = variant.option1 %}
                  {% assign size_name = variant.option2 %}

                  <button
                    type="button"
                    class="size-button {% if variant.available %}size-available{% else %}size-unavailable{% endif %}"
                    data-size-button
                    data-apparel-type="{{ apparel_name | handle }}"
                    data-size-name="{{ size_name }}"
                    data-variant-id="{{ variant.id }}"
                    data-variant-name="{{ variant.title }}"
                    data-variant-price="{{ variant.price }}"
                    data-variant-compare-price="{{ variant.compare_at_price }}"
                    data-variant-available="{{ variant.available }}"
                    {% if variant.featured_image %}
                      data-variant-image="{{ variant.featured_image | img_url: '1200x' }}"
                    {% endif %}
                    style="display: none;"
                  >
                    {{ size_name }}
                  </button>
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- Hidden variant input -->
          <input type="hidden" name="id" data-variant-id-input value="{{ current_variant.id }}">

          <!-- Quantity & Add to Cart -->
          <div class="cart-controls">
            <div class="quantity-selector">
              <button type="button" class="quantity-button" data-quantity-minus>−</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="quantity-input"
                data-quantity-input
              >
              <button type="button" class="quantity-button" data-quantity-plus>+</button>
            </div>
            <button
              type="submit"
              class="add-to-cart-button"
              data-add-to-cart
              disabled
            >
              SELECT SIZE
            </button>
          </div>
        {% endform %}

        <!-- Description -->
        <div class="product-description">
          {{ product.description }}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Cart Drawer -->
<div class="cart-drawer-overlay" id="cartDrawer">
  <div class="cart-drawer-backdrop" onclick="closeCartDrawer()"></div>
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <h2 class="cart-drawer-title">YOUR CART</h2>
      <button onclick="closeCartDrawer()" class="cart-drawer-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="cart-drawer-items" id="cartDrawerItems">
      <!-- Cart items will be dynamically inserted here -->
    </div>
    <div class="cart-drawer-footer">
      <div class="cart-drawer-total">
        <span>SUBTOTAL:</span>
        <span id="cartDrawerTotal">RM 0.00</span>
      </div>
      <a href="/cart" class="cart-drawer-button cart-drawer-view">VIEW CART</a>
      <a href="/checkout" class="cart-drawer-button cart-drawer-checkout">CHECKOUT</a>
    </div>
  </div>
</div>

