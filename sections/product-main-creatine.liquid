<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Mobile gallery scroll handling
    const scrollContainer = document.querySelector('[data-gallery-scroll]');
    const dots = document.querySelectorAll('[data-dot-index]');

    if (scrollContainer && dots.length > 0) {
      let currentIndex = 0;

      // Update dots on scroll
      scrollContainer.addEventListener('scroll', function () {
        const scrollLeft = scrollContainer.scrollLeft;
        const firstItem = scrollContainer.querySelector('.gallery-image-item');

        if (firstItem) {
          const itemWidth = firstItem.offsetWidth;
          const gap = 4;
          const stride = itemWidth + gap;
          const newIndex = Math.round(scrollLeft / stride);

          if (newIndex !== currentIndex && newIndex >= 0 && newIndex < dots.length) {
            currentIndex = newIndex;
            updateDots(currentIndex);
          }
        }
      });

      // Click on dots
      dots.forEach((dot, index) => {
        dot.addEventListener('click', function () {
          const firstItem = scrollContainer.querySelector('.gallery-image-item');
          if (firstItem) {
            const itemWidth = firstItem.offsetWidth;
            const gap = 4;
            const stride = itemWidth + gap;
            const scrollPosition = index * stride;
            scrollContainer.scrollTo({ left: scrollPosition, behavior: 'smooth' });
            currentIndex = index;
            updateDots(currentIndex);
          }
        });
      });

      function updateDots(index) {
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      // Initialize first dot as active
      updateDots(0);
    }

    // Desktop thumbnail click handling
    const thumbnails = document.querySelectorAll('[data-thumbnail]');
    const mainImage = document.querySelector('[data-main-image]');

    if (thumbnails.length > 0 && mainImage) {
      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener('click', function () {
          const imageUrl = this.dataset.fullSrc;
          mainImage.src = imageUrl;

          // Update active thumbnail
          thumbnails.forEach((t) => t.classList.remove('active'));
          this.classList.add('active');
        });
      });

      // Set first thumbnail as active
      if (thumbnails[0]) {
        thumbnails[0].classList.add('active');
      }
    }

    // Product Info JavaScript
    const form = document.getElementById('product-form-creatine');
    if (!form) return;

    const section = form.closest('.product-creatine-section') || document;

    // Pack and Weight Selection
    const packCards = section.querySelectorAll('[data-pack-card]');
    const weightContainer = section.querySelector('[data-weight-container]');
    const weightButtons = section.querySelectorAll('[data-weight-button]');
    const weightDisplay = section.querySelector('[data-weight-display]');
    // Target the hidden variant id input (required for cart form submission)
    const variantInput = form.querySelector('[data-creatine-variant-input]');
    const priceDisplay = section.querySelector('[data-product-price]');
    const addToCartButton = section.querySelector('[data-add-to-cart]');
    const btnText = addToCartButton ? addToCartButton.querySelector('.btn-text') : null;

    let selectedPackType = 'single'; // Default to single pack

    // Pack card click handling
    packCards.forEach((card) => {
      card.addEventListener('click', function () {
        if (this.classList.contains('pack-option-disabled')) return;

        const packType = this.dataset.packType;
        console.log('Pack selected:', packType); // Debug log

        // Update active state
        packCards.forEach((c) => c.classList.remove('active'));
        this.classList.add('active');

        selectedPackType = packType;

        // Single Pack (500g) - no weight selection needed
        if (packType === 'single') {
          // Hide weight container (not needed)
          if (weightContainer) weightContainer.style.display = 'none';

          // Find the 500g single variant
          const allVariants = {{ product.variants | json }};
          const singleVariant = allVariants.find(v => v.option1.trim() === '500g');

          if (singleVariant && variantInput) {
            console.log('Single Variant Found:', singleVariant.id); // Debug log
            variantInput.value = singleVariant.id;

            if (priceDisplay) {
              const price = parseFloat(singleVariant.price) / 100;
              priceDisplay.textContent = 'RM ' + price.toFixed(2);
            }

            // Update compare price for single pack
            const comparePriceDisplay = section.querySelector('[data-compare-price]');
            if (comparePriceDisplay) {
              if (singleVariant.compare_at_price && parseFloat(singleVariant.compare_at_price) > parseFloat(singleVariant.price)) {
                const comparePrice = parseFloat(singleVariant.compare_at_price) / 100;
                comparePriceDisplay.textContent = 'RM ' + comparePrice.toFixed(2);
                comparePriceDisplay.style.display = '';
              } else {
                comparePriceDisplay.style.display = 'none';
              }
            }

            if (addToCartButton) {
              const btnText = addToCartButton.querySelector('.btn-text');
              if (singleVariant.available) {
                addToCartButton.disabled = false;
                if (btnText) btnText.textContent = 'ADD TO CART';
              } else {
                addToCartButton.disabled = true;
                if (btnText) btnText.textContent = 'SOLD OUT';
              }
            }

            if (singleVariant.featured_image) {
              const mainImage = section.querySelector('[data-main-image]');
              if (mainImage) mainImage.src = singleVariant.featured_image.src;
            }
          } else {
             console.warn('Single variant (500g) not found!');
          }

        } else if (packType === 'best-value') {
          // Best Value - hide weight selection
          if (weightContainer) weightContainer.style.display = 'none';

          // Find the 500g variant safely
          const allVariants = {{ product.variants | json }};
          const bestValueVariant = allVariants.find(v => {
            // Trim whitespace to ensure exact match matches "500g + FREE 100g"
            return v.option1 && v.option1.trim() === '500g + FREE 100g';
          });

          if (bestValueVariant) {
             console.log('Best Value Variant Found:', bestValueVariant.id);

             if (variantInput) {
               variantInput.value = bestValueVariant.id;
             } else {
               console.error('Variant Input not found in DOM!');
             }

            // Update price
            if (priceDisplay) {
              const price = parseFloat(bestValueVariant.price) / 100;
              priceDisplay.textContent = 'RM ' + price.toFixed(2);
            }

            // Update compare price
            const comparePriceDisplay = section.querySelector('[data-compare-price]');
            if (comparePriceDisplay && bestValueVariant.compare_at_price) {
              if (parseFloat(bestValueVariant.compare_at_price) > parseFloat(bestValueVariant.price)) {
                const comparePrice = parseFloat(bestValueVariant.compare_at_price) / 100;
                comparePriceDisplay.textContent = 'RM ' + comparePrice.toFixed(2);
                comparePriceDisplay.style.display = '';
              } else {
                comparePriceDisplay.style.display = 'none';
              }
            }

            // Enable add to cart
            if (addToCartButton) {
              const btnText = addToCartButton.querySelector('.btn-text');
              if (bestValueVariant.available) {
                addToCartButton.disabled = false;
                if (btnText) btnText.textContent = 'ADD TO CART';
              } else {
                addToCartButton.disabled = true;
                if (btnText) btnText.textContent = 'SOLD OUT';
              }
            }

            // Update main image if variant has featured image
            if (bestValueVariant.featured_image) {
              const mainImage = section.querySelector('[data-main-image]');
              if (mainImage) {
                mainImage.src = bestValueVariant.featured_image.src;
              }
            }
          } else {
            console.error('Best Value (500g + FREE 100g) variant NOT found in product data:', allVariants);
          }
        }
      });
    });

    // Weight button click handling (kept for future use, currently no weight buttons for single)
    weightButtons.forEach((button) => {
      button.addEventListener('click', function () {
        if (this.dataset.variantAvailable === 'false') return;
        weightButtons.forEach((btn) => btn.classList.remove('active'));
        this.classList.add('active');
        updateVariant(this);
      });
    });

    // Function to update variant information
    function updateVariant(button) {
      const variantId = button.dataset.variantId;
      const variantName = button.dataset.variantName;
      const variantPrice = button.dataset.variantPrice;
      const isAvailable = button.dataset.variantAvailable === 'true';

      variantInput.value = variantId;

      if (priceDisplay) {
        const price = parseFloat(variantPrice) / 100;
        priceDisplay.textContent = 'RM ' + price.toFixed(2);
      }

      // Update compare at price if it exists
      const comparePrice = button.dataset.variantComparePrice;
      const comparePriceDisplay = section.querySelector('[data-compare-price]');
      if (comparePriceDisplay) {
        if (comparePrice && parseFloat(comparePrice) > parseFloat(variantPrice)) {
          const compareAmount = parseFloat(comparePrice) / 100;
          comparePriceDisplay.textContent = 'RM ' + compareAmount.toFixed(2);
          comparePriceDisplay.style.display = '';
        } else {
          comparePriceDisplay.style.display = 'none';
        }
      }

      // Update button state
      if (addToCartButton) {
        if (isAvailable) {
          addToCartButton.disabled = false;
          addToCartButton.textContent = 'ADD TO CART';
        } else {
          addToCartButton.disabled = true;
          addToCartButton.textContent = 'SOLD OUT';
        }
      }

      // Update images if variant has a featured image
      const variantImage = button.dataset.variantImage;
      if (variantImage) {
        // Update desktop main image
        const mainImage = section.querySelector('[data-main-image]');
        if (mainImage) {
          mainImage.src = variantImage;
        }

        // Update mobile gallery - find and scroll to matching image
        const scrollContainer = section.querySelector('[data-gallery-scroll]');
        if (scrollContainer) {
          const galleryImages = scrollContainer.querySelectorAll('.gallery-image');
          let matchingIndex = 0;

          galleryImages.forEach((img, index) => {
            if (img.src.includes(variantImage.split('/').pop().split('?')[0])) {
              matchingIndex = index;
            }
          });

          const firstItem = scrollContainer.querySelector('.gallery-image-item');
          if (firstItem) {
            const itemWidth = firstItem.offsetWidth;
            const gap = 4;
            const stride = itemWidth + gap;
            const scrollPosition = matchingIndex * stride;
            scrollContainer.scrollTo({ left: scrollPosition, behavior: 'smooth' });
          }
        }

        // Update desktop thumbnails
        const thumbnails = section.querySelectorAll('[data-thumbnail]');
        if (thumbnails.length > 0) {
          thumbnails.forEach((thumb, index) => {
            thumb.classList.remove('active');
          });
        }
      }

      // Trigger gallery update if needed
      const event = new CustomEvent('variant:changed', { detail: { variantId: variantId } });
      document.dispatchEvent(event);
    }

    // Check if variant ID is in URL and auto-select
    const urlParams = new URLSearchParams(window.location.search);
    const urlVariantId = urlParams.get('variant');
    let variantAutoSelected = false;

    if (urlVariantId) {
      const allVariants = {{ product.variants | json }};
      const urlVariant = allVariants.find(v => v.id.toString() === urlVariantId);

      if (urlVariant) {
        const weight = urlVariant.option1;

        if (weight === '500g + FREE 100g') {
          // Select Best Value pack
          const bestValueCard = section.querySelector('[data-pack-card][data-pack-type="best-value"]');
          if (bestValueCard && !bestValueCard.classList.contains('pack-option-disabled')) {
            bestValueCard.classList.add('active');
            selectedPackType = 'best-value';
            if (weightContainer) weightContainer.style.display = 'none';
            if (variantInput) variantInput.value = urlVariant.id;
            if (priceDisplay) {
              priceDisplay.textContent = 'RM ' + (parseFloat(urlVariant.price) / 100).toFixed(2);
            }
            if (addToCartButton) {
              addToCartButton.disabled = !urlVariant.available;
              addToCartButton.textContent = urlVariant.available ? 'ADD TO CART' : 'SOLD OUT';
            }
          }
          variantAutoSelected = true;
        } else if (weight === '500g') {
          // Select Single pack (500g)
          const singlePackCard = section.querySelector('[data-pack-card][data-pack-type="single"]');
          if (singlePackCard && !singlePackCard.classList.contains('pack-option-disabled')) {
            singlePackCard.classList.add('active');
            selectedPackType = 'single';
            if (weightContainer) weightContainer.style.display = 'none';
            if (variantInput) variantInput.value = urlVariant.id;
            if (priceDisplay) {
              priceDisplay.textContent = 'RM ' + (parseFloat(urlVariant.price) / 100).toFixed(2);
            }
            if (addToCartButton) {
              const btnText = addToCartButton.querySelector('.btn-text');
              addToCartButton.disabled = !urlVariant.available;
              if (btnText) btnText.textContent = urlVariant.available ? 'ADD TO CART' : 'SOLD OUT';
            }
          }
          variantAutoSelected = true;
        }
      }
    }

    // Initialize: Select single pack by default if no variant was auto-selected
    if (!variantAutoSelected) {
      const singlePackCard = section.querySelector('[data-pack-card][data-pack-type="single"]');
      if (singlePackCard && !singlePackCard.classList.contains('pack-option-disabled')) {
        singlePackCard.click();
      }
    }

    // Quantity Controls
    const quantityInput = section.querySelector('[data-quantity-input]');
    const minusButton = section.querySelector('[data-quantity-minus]');
    const plusButton = section.querySelector('[data-quantity-plus]');

    if (minusButton && quantityInput) {
      minusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        if (currentQty > 1) {
          quantityInput.value = currentQty - 1;
        }
      });
    }

    if (plusButton && quantityInput) {
      plusButton.addEventListener('click', function () {
        let currentQty = parseInt(quantityInput.value) || 1;
        quantityInput.value = currentQty + 1;
      });
    }

    // Form submission
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const submitButton = form.querySelector('[data-add-to-cart]');
      const btnText = submitButton.querySelector('.btn-text');
      const spinner = submitButton.querySelector('.loading-spinner');

      // Show loading state
      if (submitButton) {
        submitButton.disabled = true;
        if (btnText) btnText.style.opacity = '0'; // Hide text but keep width
        if (spinner) spinner.style.display = 'block';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
        });

        if (response.ok) {
          const data = await response.json();
          console.log('Added to cart:', data);

          // Open cart drawer
          openCartDrawer();
          updateCartDrawer();
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
      } finally {
        // Reset loading state
        if (submitButton) {
          submitButton.disabled = false;
          if (btnText) btnText.style.opacity = '1';
          if (spinner) spinner.style.display = 'none';
        }
      }
    });
  });
</script>

