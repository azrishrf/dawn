{% comment %}
  Product Creatine Section (Gallery + Info)
{% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}

<div class="product-creatine-section">
  <div class="product-creatine-container">
    <div class="product-creatine-content">
      <!-- Product Gallery -->
      <div class="product-gallery">
        <div class="gallery-sticky-container">
          <!-- Mobile/Tablet View - Swipeable -->
          <div class="gallery-mobile">
            <div class="gallery-mobile-wrapper">
              <div class="gallery-scroll" data-gallery-scroll>
                <div class="gallery-images-wrapper">
                  {% for image in product.images %}
                    <div class="gallery-image-item">
                      <img
                        src="{{ image | image_url: width: 800 }}"
                        alt="{{ product.title }}"
                        width="800"
                        height="1067"
                        class="gallery-image"
                        loading="lazy"
                      >
                    </div>
                  {% endfor %}
                </div>
              </div>
              <div class="gallery-dots">
                {% for image in product.images %}
                  <button class="gallery-dot" data-dot-index="{{ forloop.index0 }}"></button>
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- Desktop View - Thumbnails on Left -->
          <div class="gallery-desktop">
            <div class="gallery-thumbnails">
              {% for image in product.images %}
                <button class="gallery-thumbnail" data-thumbnail data-full-src="{{ image | image_url: width: 1200 }}">
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ product.title }}"
                    width="200"
                    height="250"
                    class="thumbnail-image"
                  >
                </button>
              {% endfor %}
            </div>
            <div class="gallery-main-image-container">
              <img
                src="{{ product.featured_image | image_url: width: 1200 }}"
                alt="{{ product.title }}"
                width="1200"
                height="1500"
                class="gallery-main-image"
                data-main-image
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <h1 class="product-title">{{ product.title }}</h1>
        {% if product.metafields.custom.subtitle %}
          <p class="product-subtitle">{{ product.metafields.custom.subtitle }}</p>
        {% endif %}

        <!-- Price -->
        <div class="product-price">
          <span data-product-price>RM {{ current_variant.price | money_without_currency }}</span>
          <span
            class="price-compare"
            data-compare-price
            {% unless current_variant.compare_at_price > current_variant.price %}
              style="display: none;"
            {% endunless %}
          >
            RM {{ current_variant.compare_at_price | money_without_currency }}
          </span>
        </div>

        <!-- Product Form -->
        {% form 'product', product, id: 'product-form-creatine', data-product-form: '' %}
          <!-- Pack Selection -->
          <div class="pack-selection-container">
            <div class="pack-options-grid">
              <!-- Single Pack (100g-400g) -->
              {% assign single_available = false %}
              {% assign single_variant = null %}
              {% for variant in product.variants %}
                {% assign weight = variant.option1 %}
                {% if weight == '500g' %}
                  {% assign single_variant = variant %}
                  {% if variant.available %}
                    {% assign single_available = true %}
                  {% endif %}
                {% endif %}
              {% endfor %}

              <div
                class="pack-option-card {% if single_available == false %}pack-option-disabled{% endif %}"
                data-pack-card
                data-pack-type="single"
              >
                {% comment %} <span class="pack-badge pack-badge-dark">MOST POPULAR</span> {% endcomment %}
                <p class="pack-label">500g</p>
                <div class="pack-image-wrapper">
                  {% assign single_img_index = section.settings.single_image_index | minus: 1 %}
                  {% if product.images[single_img_index] %}
                    {% assign single_image = product.images[single_img_index] %}
                  {% else %}
                    {% assign single_image = product.featured_image %}
                  {% endif %}
                  <img
                    src="{{ single_image | image_url: width: 400 }}"
                    alt="Single Pack"
                    width="400"
                    height="430"
                    class="pack-image"
                    loading="lazy"
                  >
                </div>
                <div class="pack-info">
                  {% if single_variant %}
                    <p class="pack-price">RM {{ single_variant.price | money_without_currency }}</p>
                    <div class="pack-freebie">100 SERVINGS</div>
                    <p class="pack-save">SAVE RM10</p>
                  {% else %}
                    <p class="pack-price">Not Available</p>
                  {% endif %}
                </div>
              </div>

              <!-- Best Value Pack (500g) -->
              {% assign best_value_variant = product.variants | where: 'option1', '500g + FREE 100g' | first %}
              <div
                class="pack-option-card {% if best_value_variant.available == false %}pack-option-disabled{% endif %}"
                data-pack-card
                data-pack-type="best-value"
              >
                <span class="pack-badge">BEST VALUE</span>
                <p class="pack-label">500g + FREE 100g</p>
                <div class="pack-image-wrapper">
                  {% assign best_value_img_index = section.settings.best_value_image_index | minus: 1 %}
                  {% if product.images[best_value_img_index] %}
                    {% assign best_value_image = product.images[best_value_img_index] %}
                  {% else %}
                    {% assign best_value_image = product.featured_image %}
                  {% endif %}
                  <img
                    src="{{ best_value_image | image_url: width: 400 }}"
                    alt="Best Value Pack"
                    width="400"
                    height="430"
                    class="pack-image"
                    loading="lazy"
                  >
                </div>
                <div class="pack-info">
                  {% if best_value_variant %}
                    <p class="pack-price">RM {{ best_value_variant.price | money_without_currency }}</p>
                    <div class="pack-freebie">120 SERVINGS</div>
                    <p class="pack-save">SAVE RM20</p>
                  {% else %}
                    <p class="pack-price">Not Available</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          <!-- Hidden variant input - required for Shopify cart form submission -->
          <input
            type="hidden"
            name="id"
            data-creatine-variant-input
            value="{{ product.variants | map: 'id' | first }}"
          >

          <!-- Quantity & Add to Cart -->
          <div class="cart-controls">
            <div class="quantity-selector">
              <button type="button" class="quantity-button" data-quantity-minus>−</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="quantity-input"
                data-quantity-input
              >
              <button type="button" class="quantity-button" data-quantity-plus>+</button>
            </div>
            <button
              type="submit"
              class="add-to-cart-button"
              data-add-to-cart
              disabled
            >
              <span class="btn-text">SELECT NET WEIGHT</span>
              <span class="loading-spinner" style="display: none;">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  role="presentation"
                  class="spinner"
                  viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </span>
            </button>
          </div>
        {% endform %}

        <!-- Description -->
        <div class="product-description">
          {{ product.description }}
        </div>
      </div>
    </div>
  </div>
</div>

{% render 'custom-cart-drawer' %}

