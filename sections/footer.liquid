{% comment %}
  Footer Section
  Displays company information, navigation links, and social media
{% endcomment %}

<style>
  .footer-section {
    background-color: #ffffff;
    {% comment %} border-top: 1px solid #000000; {% endcomment %}
    color: #000000;
    margin-top: 100px;
    padding-top: 32px;
    padding-bottom: 10px;
  }

  .footer-container {
    max-width: 1600px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
  }

  @media (min-width: 1024px) {
    .footer-container {
      padding-left: 48px;
      padding-right: 48px;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .footer-column h4 {
    font-weight: bold;
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-top: 0;
    margin-bottom: 6px;
  }

  .footer-links li:last-child {
    margin-bottom: 0;
  }

  .footer-links a {
    font-size: 14px;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #000000;
    text-decoration: underline;
  }

  .column4-column {
    grid-column: span 1;
  }

  @media (min-width: 1024px) {
    .column4-column {
      grid-column: span 2;
    }
  }

  .column4-description {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 16px;
  }

  .column4-form {
    display: flex;
    border-bottom: 1px solid #000000;
    padding-bottom: 8px;
    margin-bottom: 0;
  }

  .column4-input {
    width: 100%;
    outline: none;
    border: none;
    font-size: 14px;
    background: transparent;
    font-family: 'Funnel Display', sans-serif;
  }

  .column4-input::placeholder {
    color: #9ca3af;
  }

  .column4-button {
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 0.1em;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    color: #000000;
    font-family: 'Funnel Display', sans-serif;
  }

  .column4-button:hover {
    color: #666666;
  }

  .social-links {
    display: flex;
    gap: 24px;
    margin: 20px 0;
  }

  .social-links a {
    display: inline-block;
    cursor: pointer;
    color: #000000;
    text-decoration: none;
  }

  .social-links a:hover {
    color: #666666;
  }

  .footer-bottom {
    font-size: 12px;
    color: #6b7280;
    padding-top: 20px;
    border-top: 1px solid #f3f4f6;
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 16px;
  }

  @media (min-width: 1024px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0;
    }
  }

  .footer-bottom-left {
    text-align: center;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .footer-bottom-left {
      text-align: left;
      width: auto;
    }
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-payment-methods {
    text-align: center;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  @media (min-width: 1024px) {
    .footer-payment-methods {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
  }

  .footer-payment-methods p {
    font-size: 12px;
    font-weight: 400;
    color: #6b7280;
    margin: 0;
    white-space: nowrap;
  }

  .footer-payment-image {
    display: block;
    max-width: 400px;
    width: 100%;
    height: auto;
  }
  .footer-contact-info {
    {% comment %} margin-top: 32px; {% endcomment %}
    font-size: 14px;
    color: #6b7280;
    line-height: 1.6;
  }

  .footer-contact-info a {
    color: inherit !important;
    text-decoration: none !important;
    pointer-events: none;
  }

  .footer-contact-info p {
    margin: 0;
    margin-bottom: 8px;
  }

  .footer-contact-info strong {
    font-weight: 600;
    color: #000000;
  }
</style>

<footer class="footer-section">
  <div class="footer-container">
    <div class="footer-grid">
      {% comment %} Column 1 - About Us {% endcomment %}
      <div class="footer-column">
        <h4>{{ section.settings.column1_title }}</h4>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'column1_link' %}
              <li>
                <a href="{{ block.settings.link }}">
                  {{ block.settings.link_text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      {% comment %} Column 2 - Shop {% endcomment %}
      <div class="footer-column">
        <h4>{{ section.settings.column2_title }}</h4>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'column2_link' %}
              <li>
                <a href="{{ block.settings.link }}">
                  {{ block.settings.link_text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      {% comment %} Column 3 - Customer Care {% endcomment %}
      <div class="footer-column">
        <h4>{{ section.settings.column3_title }}</h4>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'column3_link' %}
              <li>
                <a href="{{ block.settings.link }}">
                  {{ block.settings.link_text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      {% comment %} Column 4 - Contact Us {% endcomment %}
      <div class="footer-column column4-column">
        <h4>{{ section.settings.column4_title }}</h4>
        {% comment %}
          <p class="column4-description">{{ section.settings.column4_description }}</p>

          {% form 'customer' %}
            <div class="column4-form">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.column4_placeholder }}"
                class="column4-input"
                required
              >
              <button type="submit" class="column4-button">
                {{ section.settings.column4_button_text }}
              </button>
            </div>
          {% endform %}
        {% endcomment %}

        <div class="footer-contact-info">
          {% if section.settings.contact_company_name != blank %}
            <p>
              <strong>{{ section.settings.contact_company_name }}</strong> {{ section.settings.contact_reg_number }}
            </p>
          {% endif %}
          {% if section.settings.contact_address != blank %}
            <p><strong>Address :</strong> {{ section.settings.contact_address }}</p>
          {% endif %}
          {% if section.settings.contact_phone != blank %}
            <p><strong>Phone :</strong> {{ section.settings.contact_phone }}</p>
          {% endif %}
          {% if section.settings.contact_email != blank %}
            <p><strong>Email :</strong> {{ section.settings.contact_email }}</p>
          {% endif %}
        </div>

        <div class="social-links">
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.twitter_url != blank %}
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.shopee_url != blank %}
            <a href="{{ section.settings.shopee_url }}" target="_blank" rel="noopener">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 50 50">
                <path d="M 25 1 C 19.672869 1 15.604123 5.9531422 15.166016 12 L 5.0585938 12 C 3.9235937 12 2.999376 12.980995 3.0625 14.113281 L 4.7871094 44.285156 C 4.9365844 46.922145 7.1369035 49 9.7773438 49 L 40.222656 49 C 42.863851 49 45.063433 46.921831 45.212891 44.285156 L 46.9375 14.115234 C 47.002643 12.982141 46.076406 12 44.941406 12 L 34.833984 12 C 34.395877 5.9531422 30.327131 1 25 1 z M 25 3 C 29.036936 3 32.408924 6.8867916 32.835938 12 L 17.164062 12 C 17.591075 6.8867916 20.963064 3 25 3 z M 25.080078 18 C 28.920078 18 31.799062 20.060938 32.039062 20.210938 L 31.009766 21.880859 C 30.759766 21.710859 30.310625 21.439844 30.140625 21.339844 C 29.120625 20.789844 27.240078 19.970703 25.080078 19.970703 C 21.830078 19.970703 19.480469 21.77 19.480469 24.25 C 19.480469 26.72 21.660234 27.699766 25.240234 29.009766 C 28.870234 30.329766 32.970703 31.829609 32.970703 36.599609 C 32.970703 40.189609 29.430156 43.009766 24.910156 43.009766 C 20.920156 43.009766 17.640078 40.560156 16.830078 39.910156 L 17.939453 38.259766 C 17.969453 38.289766 21.160156 41.029297 24.910156 41.029297 C 28.270156 41.029297 31 39.039609 31 36.599609 C 31 33.439609 28.570547 32.319375 24.560547 30.859375 C 21.260547 29.649375 17.509766 28.28 17.509766 24.25 C 17.509766 20.69 20.760078 18 25.080078 18 z"></path>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <p>{{ section.settings.copyright_text }}</p>
      </div>

      {% if section.settings.payment_methods_image != blank %}
        <div class="footer-payment-methods">
          <p>{{ section.settings.payment_methods_title }}</p>

          <img
            src="{{ section.settings.payment_methods_image | img_url: 'master' }}"
            alt="{{ section.settings.payment_methods_title }}"
            class="footer-payment-image"
            width="auto"
            height="auto"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
</footer>

