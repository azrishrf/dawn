{% comment %}
  Athletes Section
  Displays sponsored athletes in a slider with images and names
{% endcomment %}

<style>
  .athletes-section {
    background-color: #ffffff;
    padding: 0;
    max-width: 1700px;
    margin: 0 auto;
  }

  .athletes-container {
    {% comment %} max-width: 1400px; {% endcomment %}
    margin: 0 auto;
  }

  .athletes-header {
    text-align: center;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 20px;
    padding: 0 16px 16px 16px;
  }

  .athletes-title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    font-size: 2.4rem;
    color: #000000;
    margin: 0 0 6px 0;
    {% comment %} letter-spacing: 0.05em; {% endcomment %}
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .athletes-title {
      font-size: 3.2rem;
    }
  }

  .athletes-description {
    font-size: 1.4rem;
    line-height: 1.6;
    color: #333333;
    margin: 0;
  }

  @media (min-width: 768px) {
    .athletes-description {
      font-size: 1.6rem;
    }
  }

  /* Slider Wrapper */
  .athletes-slider-wrapper {
    position: relative;
    padding: 0;
  }

  .athletes-slider-container {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    display: flex;
    gap: 0;
    padding: 0;
  }

  .athletes-slider-container::-webkit-scrollbar {
    display: none;
  }

  .athlete-card {
    flex: 0 0 100vw;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .athletes-container {
      display: flex;
      flex-direction: column;
    }

    .athletes-header {
      order: -1;
      width: 100%;
      padding: 0 40px;
    }

    .athletes-slider-container {
      justify-content: flex-start;
      gap: 4px; /* Gap between items */
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      display: flex;
    }

    .athlete-clone-start,
    .athlete-clone-end {
      display: flex !important;
    }

    .athlete-card {
      flex: 0 0 calc((100% - 8px) / 3);
      max-width: none;
      scroll-snap-align: start;
      min-width: 0;
      width: auto !important;
    }
  }

  {% comment %} @media (min-width: 1920px) {
    .athlete-card {
      flex: 0 0 calc(25% - 3px);
    }
  }

  @media (min-width: 2560px) {
    .athlete-card {
      flex: 0 0 calc(20% - 3px);
    }
  } {% endcomment %}

  .athlete-image-wrapper {
    width: 100%;
    aspect-ratio: 1320 / 1636;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .athlete-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .athlete-name {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: 1.8rem;
    color: #000000;
    margin: 0 0 5px 0;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .athlete-title {
    font-size: 1.4rem;
    color: #666666;
    margin: 0;
    font-weight: 500;
    text-transform: uppercase;
  }

  .athlete-instagram {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: inherit;
  }

  .athlete-instagram svg {
    width: 16px;
    height: 16px;
    fill: #E4405F;
  }

  .athlete-instagram-username {
    font-size: 1.2rem;
    color: #666666;
    font-weight: 500;
    text-transform: none;
  }
</style>

<div class="athletes-section">
  <div class="athletes-container">
    <!-- Athletes Slider (First) -->
    <div class="athletes-slider-wrapper">
      <div class="athletes-slider-container" id="athletes-slider-{{ section.id }}">
        {%- comment -%} Clone athletes at the end for infinite loop {%- endcomment -%}
        {% for block in section.blocks %}
          {% if block.type == 'athlete' %}
            <div class="athlete-card athlete-clone-end" data-index="{{ forloop.index0 }}">
              <div class="athlete-image-wrapper">
                {{
                  block.settings.video
                  | video_tag:
                    class: 'athlete-image',
                    autoplay: true,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    controls: false
                }}
              </div>
              <h3 class="athlete-name">
                {{ block.settings.name }}
                {% if block.settings.instagram_username != blank %}
